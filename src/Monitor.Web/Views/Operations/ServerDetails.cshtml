@using Monitor.Web.Services
@model ServerDetailsViewModel
@{
    ViewData["Title"] = Model.Server.Name;
    var server = Model.Server;
    var evidence = Model.Evidence;
    var intelligence = ServerIntelligenceProjection.Build(Model);
    var runtimePressure = intelligence.RuntimePressure;
    var runtimePressureState = runtimePressure?.Classification switch
    {
        RuntimePressureClass.Healthy => intelligence.EvidenceState == ServerIntelligenceEvidenceState.Stale ? "warning" : "healthy",
        RuntimePressureClass.Elevated => "warning",
        RuntimePressureClass.High => "warning",
        RuntimePressureClass.Critical => "critical",
        _ => "unknown"
    };
    var operatorMetadata = ViewData["ServerOperatorMetadata"] as ServerOperatorMetadata;
    var maintenanceActive = ViewData["MaintenanceActive"] as bool? ?? false;
    var alertSuppressed = ViewData["AlertSuppressed"] as bool? ?? false;
    var isLive = server.Source is ServerDataSource.LiveFresh or ServerDataSource.LiveStale;
    var isUnavailable = server.Source == ServerDataSource.RegisteredUnavailable;
    var isStale = server.Source == ServerDataSource.LiveStale;
    var hasRegisteredExportContext = Guid.TryParse(server.Id, out var exportRegistrationId) && exportRegistrationId != Guid.Empty;
    var stateName = server.State.ToString().ToLowerInvariant();
    var freshnessLabel = server.Source switch
    {
        ServerDataSource.LiveFresh => "Fresh cached snapshot",
        ServerDataSource.LiveStale => "Stale cached snapshot",
        ServerDataSource.RegisteredUnavailable => "Snapshot unavailable",
        _ => "Development preview"
    };
    var collectionLabel = evidence is null ? "Not collected" : evidence.CollectedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz");
    var uptime = evidence is null
        ? "Not collected"
        : TimeSpan.FromSeconds(Math.Max(0, evidence.UptimeSeconds)).TotalDays >= 1
            ? $"{TimeSpan.FromSeconds(Math.Max(0, evidence.UptimeSeconds)).TotalDays:0.0} days"
            : $"{TimeSpan.FromSeconds(Math.Max(0, evidence.UptimeSeconds)).TotalHours:0.0} hours";
    var memory = evidence?.Memory;
    var databases = evidence?.Databases;
    var backups = evidence?.Backups;
    var jobs = evidence?.Jobs;
    var storage = evidence?.Storage;
    var blocking = evidence?.Blocking;
    var performance = evidence?.Performance;
    var databaseProblems = databases is null ? (int?)null : databases.Restoring + databases.Recovering + databases.RecoveryPending + databases.Suspect + databases.Emergency + databases.OfflineOrOther;
    var databaseState = server.DatabaseTotal == 0 ? "unknown" : server.DatabaseOnline == server.DatabaseTotal ? "healthy" : "critical";
    var memoryState = memory is null ? "unknown" : memory.IsPhysicalMemoryLow || memory.IsVirtualMemoryLow || memory.SqlProcessMemoryUtilizationPercent >= 85 ? "warning" : "healthy";
    var backupState = backups is null ? "unknown" : backups.MissingFullBackupLast24Hours > 0 ? "warning" : "healthy";
    var jobsState = jobs is null ? "unknown" : jobs.FailedLastRun > 0 ? "warning" : "healthy";
    var blockingState = blocking is null ? "unknown" : blocking.BlockedRequests > 0 ? "warning" : "healthy";
    var runtimeState = performance is null ? "unknown" : performance.RunnableTasks > 0 || performance.PendingIoRequests > 0 ? "warning" : "healthy";
    var refreshMessage = TempData["SnapshotRefresh"] as string;
    var refreshStatus = TempData["SnapshotRefreshStatus"] as string ?? string.Empty;
    var refreshFreshness = TempData["SnapshotRefreshFreshness"] as string ?? string.Empty;
    var refreshCss = refreshStatus == "Refreshed" && refreshFreshness == "Fresh"
        ? "healthy"
        : refreshStatus == "Refreshed" || refreshStatus == "Throttled"
            ? "warning"
            : "unknown";
}

<div class="data-banner">
    <strong>@(isLive ? (isStale ? "STALE CACHED SQL EVIDENCE" : "FRESH CACHED SQL EVIDENCE") : isUnavailable ? "REGISTERED · SNAPSHOT UNAVAILABLE" : "DEVELOPMENT DATA")</strong>
    <span>Every production value below is either backed by the cached snapshot or explicitly labeled Not collected. Opening this page never initiates monitored-SQL collection.</span>
</div>

@if (!string.IsNullOrWhiteSpace(refreshMessage))
{
    <section class="refresh-feedback state-@refreshCss" role="status" aria-live="polite">
        <strong>@(refreshStatus == "Throttled" ? "Refresh deferred" : refreshFreshness == "Stale" ? "Stale snapshot retained" : "Snapshot refresh")</strong>
        <span>@refreshMessage</span>
    </section>
}

<section class="server-command-hero glass-panel state-@stateName">
    <div class="server-command-top">
        <div class="server-command-title">
            <span class="health-orb state-@stateName" aria-hidden="true"></span>
            <div><span class="eyebrow">SERVER DETAILS · EVIDENCE FIRST</span><h2>@server.Name</h2><p>@server.Version · @server.Edition</p></div>
        </div>
        <div class="server-command-meta">
            <div><small>Availability state</small><strong class="state-@stateName">@server.State</strong></div>
            <div><small>Freshness</small><strong>@freshnessLabel</strong></div>
            <div><small>Snapshot age</small><strong data-snapshot-age data-initial-age="@server.LastScanSecondsAgo">@(isUnavailable ? "Not collected" : $"{server.LastScanSecondsAgo} sec ago")</strong></div>
        </div>
    </div>
    <div class="server-command-band">
        <div class="command-stat state-@(isLive ? "healthy" : "unknown")"><small>Collected at</small><strong>@collectionLabel</strong></div>
        <div class="command-stat state-unknown"><small>CPU</small><strong>@(server.CpuPercent is int cpu ? $"{cpu}%" : "Not collected")</strong></div>
        <div class="command-stat state-@memoryState"><small>SQL memory</small><strong>@(memory is null ? "Not collected" : $"{memory.SqlProcessMemoryUtilizationPercent}%")</strong></div>
        <div class="command-stat state-@databaseState"><small>Databases</small><strong>@(server.DatabaseTotal == 0 ? "Not collected" : $"{server.DatabaseOnline} / {server.DatabaseTotal} online")</strong></div>
        <div class="command-stat state-@jobsState"><small>SQL Agent</small><strong>@(jobs is null ? "Not collected" : $"{jobs.EnabledJobs}/{jobs.TotalJobs} enabled · {jobs.FailedLastRun} failed")</strong></div>
    </div>
</section>

@if (hasRegisteredExportContext)
{
    <section class="glass-panel panel-pad" style="margin-top:14px" aria-labelledby="server-evidence-exports">
        <div class="panel-heading">
            <div><span class="eyebrow">BOUNDED EVIDENCE EXPORTS</span><h3 id="server-evidence-exports">Download this registered server context</h3></div>
            <span class="snapshot-note">Viewer+ · cache only</span>
        </div>
        <p class="panel-copy">These downloads reuse the existing cached Server Intelligence and Database Health export contracts. They do not refresh the snapshot or contact the monitored SQL Server.</p>
        <div class="report-actions">
            <a class="secondary-button" asp-controller="EnterpriseReports" asp-action="ServerIntelligence" asp-route-registrationId="@exportRegistrationId" aria-label="Download cached server intelligence CSV for @server.Name">Download server intelligence CSV</a>
            <a class="secondary-button" asp-controller="EnterpriseReports" asp-action="DatabaseHealth" asp-route-registrationId="@exportRegistrationId" aria-label="Download cached database health CSV for @server.Name">Download database health CSV</a>
        </div>
    </section>
}

@if (isUnavailable)
{
    <section class="recovery-panel glass-panel" aria-labelledby="recovery-title">
        <div><span class="eyebrow">CONNECTION / COLLECTION</span><h3 id="recovery-title">Registered target has no usable cached snapshot</h3><p>Retest connectivity and the protected credential boundary, validate monitoring permissions, then request one bounded refresh. No missing metric is interpreted as zero.</p></div>
        <div class="recovery-actions">
            @if (User.IsInRole(MonitorRoles.Administrator))
            {
                <a class="secondary-button" asp-controller="ConnectionLab" asp-action="Index">Open Connection Lab</a>
            }
            @if (User.IsInRole(MonitorRoles.Administrator) || User.IsInRole(MonitorRoles.Operator))
            {
                <form asp-action="RefreshServer" asp-route-id="@server.Id" method="post"><button class="secondary-button" type="submit">Retry bounded snapshot</button></form>
            }
        </div>
    </section>
}

<section class="dashboard-grid" style="margin-top:14px">
    <article class="glass-panel panel-span-2 ops-panel">
        <div class="panel-heading"><div><span class="eyebrow">SNAPSHOT IDENTITY</span><h3>Instance and collection context</h3></div><span class="snapshot-note">@freshnessLabel</span></div>
        <div class="definition-grid">
            <div><small>Server name</small><strong>@server.Name</strong></div>
            <div><small>Instance</small><strong>@(string.IsNullOrWhiteSpace(evidence?.InstanceName) ? "Default / not reported" : evidence.InstanceName)</strong></div>
            <div><small>Version</small><strong>@server.Version</strong></div>
            <div><small>Edition</small><strong>@server.Edition</strong></div>
            <div><small>Uptime</small><strong>@uptime</strong></div>
            <div><small>Collected at</small><strong>@collectionLabel</strong></div>
        </div>
    </article>
    <article class="glass-panel ops-panel">
        <div class="panel-heading"><div><span class="eyebrow">SAFE REFRESH</span><h3>Collection boundary</h3></div></div>
        <p class="panel-copy">Normal GET navigation reads cache only. Manual refresh is an explicit protected POST and remains concurrency-bounded and audited.</p>
        @if (User.IsInRole(MonitorRoles.Administrator) || User.IsInRole(MonitorRoles.Operator))
        {
            <form asp-action="RefreshServer" asp-route-id="@server.Id" method="post"><button class="secondary-button full-button" type="submit">Refresh snapshot</button></form>
        }
    </article>
</section>

<section class="dashboard-grid" style="margin-top:14px" aria-labelledby="server-intelligence-title">
    <article class="glass-panel panel-span-2 ops-panel">
        <div class="panel-heading"><div><span class="eyebrow">DBA INTELLIGENCE · BATCH-300 WIRED</span><h3 id="server-intelligence-title">Cached estate classification</h3></div><span class="snapshot-note">@intelligence.EvidenceStateLabel</span></div>
        <div class="definition-grid">
            <div><small>Display identity</small><strong>@intelligence.DisplayLabel</strong></div>
            <div><small>SQL major</small><strong>@(intelligence.MajorVersion?.ToString() ?? "Not collected")</strong></div>
            <div><small>Version family</small><strong>@(intelligence.MajorVersion.HasValue ? intelligence.VersionFamily : "Not collected")</strong></div>
            <div><small>Support baseline</small><strong>@intelligence.VersionSupportLabel</strong></div>
            <div><small>Edition class</small><strong>@intelligence.EditionClass</strong></div>
            <div><small>Uptime band</small><strong>@(evidence is null ? "Not collected" : intelligence.UptimeBand.ToString())</strong></div>
        </div>
        <p class="server-mini-note">These labels reuse the CI-verified B300 estate identity rules over the cached Server Details read model. No monitored SQL query is started by this GET.</p>
    </article>

    <article class="glass-panel ops-panel state-@runtimePressureState">
        <div class="panel-heading"><div><span class="eyebrow">COMPOSITE RUNTIME PRESSURE</span><h3>Memory + blocking + scheduler + I/O</h3></div><span class="snapshot-note">@intelligence.RuntimePressureStatusLabel</span></div>
        @if (runtimePressure is null)
        {
            <p class="panel-copy"><strong>Unavailable.</strong> Composite pressure requires usable memory, blocking and performance evidence from the cached snapshot. Missing or unavailable evidence is not replaced with zero.</p>
        }
        else
        {
            <div class="definition-grid">
                <div><small>Pressure score</small><strong>@runtimePressure.Score / 100</strong></div>
                <div><small>Classification</small><strong>@runtimePressure.Classification</strong></div>
                <div><small>Active domains</small><strong>@intelligence.RuntimeSignalsLabel</strong></div>
            </div>
            <p class="server-mini-note">The score is a deterministic bounded projection over <strong>@intelligence.EvidenceStateLabel</strong>. It is decision support only and does not execute remediation.</p>
        }
    </article>
</section>

<section class="dashboard-grid" style="margin-top:14px">
    <article class="glass-panel panel-span-2 ops-panel state-@databaseState">
        <div class="panel-heading"><div><span class="eyebrow">DATABASE AVAILABILITY</span><h3>Observed database states</h3></div><strong>@(server.DatabaseTotal == 0 ? "Not collected" : $"{server.DatabaseOnline}/{server.DatabaseTotal} online")</strong></div>
        @if (databases is null)
        {
            <p class="panel-copy">Detailed database state evidence is not collected in this snapshot.</p>
        }
        else
        {
            <div class="definition-grid">
                <div><small>Restoring</small><strong>@databases.Restoring</strong></div>
                <div><small>Recovering</small><strong>@databases.Recovering</strong></div>
                <div><small>Recovery pending</small><strong>@databases.RecoveryPending</strong></div>
                <div><small>Suspect</small><strong>@databases.Suspect</strong></div>
                <div><small>Emergency</small><strong>@databases.Emergency</strong></div>
                <div><small>Offline / other</small><strong>@databases.OfflineOrOther</strong></div>
            </div>
            <p class="server-mini-note">Problem-state count: <strong>@databaseProblems</strong>. Values are snapshot evidence, not inferred health.</p>
        }
    </article>

    <article class="glass-panel ops-panel state-@memoryState">
        <div class="panel-heading"><div><span class="eyebrow">MEMORY EVIDENCE</span><h3>SQL process and OS headroom</h3></div></div>
        @if (memory is null)
        {
            <p class="panel-copy">Not collected.</p>
        }
        else
        {
            <div class="definition-grid">
                <div><small>SQL utilization</small><strong>@memory.SqlProcessMemoryUtilizationPercent%</strong></div>
                <div><small>SQL physical memory</small><strong>@((memory.SqlProcessPhysicalMemoryKb / 1024d / 1024d).ToString("0.0")) GB</strong></div>
                <div><small>Total physical memory</small><strong>@((memory.TotalPhysicalMemoryKb / 1024d / 1024d / 1024d).ToString("0.0")) GB</strong></div>
                <div><small>Available physical memory</small><strong>@((memory.AvailablePhysicalMemoryKb / 1024d / 1024d).ToString("0.0")) GB</strong></div>
                <div><small>Physical memory low</small><strong>@(memory.IsPhysicalMemoryLow ? "YES" : "NO")</strong></div>
                <div><small>Virtual memory low</small><strong>@(memory.IsVirtualMemoryLow ? "YES" : "NO")</strong></div>
            </div>
            <p class="server-mini-note">System memory state: <strong>@memory.SystemMemoryState</strong></p>
        }
    </article>
</section>

<section class="dashboard-grid" style="margin-top:14px">
    <article class="glass-panel ops-panel state-@backupState">
        <div class="panel-heading"><div><span class="eyebrow">BACKUP EVIDENCE</span><h3>Full-backup coverage</h3></div></div>
        @if (backups is null)
        {
            <p class="panel-copy">Not collected.</p>
        }
        else
        {
            <div class="definition-grid">
                <div><small>Backed up ≤24h</small><strong>@backups.BackedUpLast24Hours</strong></div>
                <div><small>Missing full backup ≤24h</small><strong>@backups.MissingFullBackupLast24Hours</strong></div>
                <div><small>Last full backup</small><strong>@(backups.LastFullBackupAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz") ?? "None observed")</strong></div>
            </div>
        }
    </article>

    <article class="glass-panel ops-panel state-@jobsState">
        <div class="panel-heading"><div><span class="eyebrow">SQL AGENT</span><h3>Observed job facts</h3></div></div>
        @if (jobs is null)
        {
            <p class="panel-copy">Not collected.</p>
        }
        else
        {
            <div class="definition-grid">
                <div><small>Total jobs</small><strong>@jobs.TotalJobs</strong></div>
                <div><small>Enabled jobs</small><strong>@jobs.EnabledJobs</strong></div>
                <div><small>Failed last run</small><strong>@jobs.FailedLastRun</strong></div>
            </div>
            <p class="server-mini-note">No synthetic “healthy job” count is calculated.</p>
        }
    </article>

    <article class="glass-panel ops-panel">
        <div class="panel-heading"><div><span class="eyebrow">STORAGE ALLOCATION</span><h3>Observed SQL files</h3></div></div>
        @if (storage is null)
        {
            <p class="panel-copy">Not collected.</p>
        }
        else
        {
            <div class="definition-grid">
                <div><small>Total allocated</small><strong>@((storage.TotalAllocatedBytes / 1024d / 1024d / 1024d).ToString("0.00")) GB</strong></div>
                <div><small>Data allocated</small><strong>@((storage.DataAllocatedBytes / 1024d / 1024d / 1024d).ToString("0.00")) GB</strong></div>
                <div><small>Log allocated</small><strong>@((storage.LogAllocatedBytes / 1024d / 1024d / 1024d).ToString("0.00")) GB</strong></div>
            </div>
        }
    </article>
</section>

<section class="dashboard-grid" style="margin-top:14px">
    <article class="glass-panel ops-panel state-@blockingState">
        <div class="panel-heading"><div><span class="eyebrow">BLOCKING</span><h3>Current blocking evidence</h3></div></div>
        @if (blocking is null)
        {
            <p class="panel-copy">Not collected.</p>
        }
        else
        {
            <div class="definition-grid">
                <div><small>Blocked requests</small><strong>@blocking.BlockedRequests</strong></div>
                <div><small>Maximum wait</small><strong>@blocking.MaxWaitMilliseconds ms</strong></div>
            </div>
        }
    </article>

    <article class="glass-panel ops-panel state-@runtimeState">
        <div class="panel-heading"><div><span class="eyebrow">RUNTIME PRESSURE</span><h3>Bounded scheduler / I/O facts</h3></div></div>
        @if (performance is null)
        {
            <p class="panel-copy">Not collected.</p>
        }
        else
        {
            <div class="definition-grid">
                <div><small>Active requests</small><strong>@performance.ActiveRequests</strong></div>
                <div><small>Runnable tasks</small><strong>@performance.RunnableTasks</strong></div>
                <div><small>Pending I/O requests</small><strong>@performance.PendingIoRequests</strong></div>
            </div>
        }
    </article>

    <article class="glass-panel ops-panel state-unknown">
        <div class="panel-heading"><div><span class="eyebrow">CPU</span><h3>Collection status</h3></div></div>
        <p class="panel-copy"><strong>Not collected.</strong> CPU remains outside the v0.1 bounded snapshot contract. This page intentionally does not infer CPU pressure from another signal.</p>
    </article>
</section>

@if (operatorMetadata is not null)
{
    <section class="glass-panel panel-pad" style="margin-top:14px" aria-labelledby="enterprise-server-context">
        <div class="panel-heading"><div><span class="eyebrow">ENTERPRISE GOVERNANCE</span><h3 id="enterprise-server-context">Operator context</h3></div><div><a class="secondary-button" asp-controller="Operations" asp-action="History" asp-route-registrationId="@server.Id">View history</a> <a class="secondary-button" asp-controller="EnterpriseOperations" asp-action="Overview">@(User.IsInRole(MonitorRoles.Administrator) ? "Manage" : "View") metadata</a></div></div>
        <div class="definition-grid">
            <div><small>Environment</small><strong>@operatorMetadata.Environment</strong></div>
            <div><small>Group</small><strong>@(operatorMetadata.Group ?? "Unassigned")</strong></div>
            <div><small>Tags</small><strong>@(operatorMetadata.Tags.Length == 0 ? "None" : string.Join(", ", operatorMetadata.Tags))</strong></div>
            <div><small>Maintenance</small><strong>@(maintenanceActive ? "Active" : "Inactive")</strong></div>
            <div><small>Alert suppression</small><strong>@(alertSuppressed ? "Active" : "Inactive")</strong></div>
            <div><small>Metadata updated</small><strong>@operatorMetadata.UpdatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")</strong></div>
        </div>
    </section>
}
