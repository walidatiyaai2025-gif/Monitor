@model IReadOnlyList<ServerCard>
@{
    ViewData["Title"] = "Database Health";
    var total = Model.Sum(server => server.DatabaseTotal);
    var online = Model.Sum(server => server.DatabaseOnline);
    var unavailable = total - online;
    var availability = total == 0 ? 0 : (int)Math.Round((double)online * 100 / total);
    var fullyOnline = Model.Count(server => server.DatabaseTotal > 0 && server.DatabaseOnline == server.DatabaseTotal && server.State != HealthState.Offline);
    var impacted = Model.Count(server => server.State == HealthState.Offline || server.DatabaseOnline < server.DatabaseTotal);
    var offline = Model.Count(server => server.State == HealthState.Offline);
    var detailed = Model.Where(server => server.Source != ServerDataSource.Demo && server.DatabaseHealth is not null).ToList();
    var suspectCount = detailed.Sum(server => server.DatabaseHealth!.SuspectCount);
    var recoveryCount = detailed.Sum(server => server.DatabaseHealth!.RecoveryCount);
    var offlineDatabaseCount = detailed.Sum(server => server.DatabaseHealth!.OfflineCount);
    var emergencyCount = detailed.Sum(server => server.DatabaseHealth!.EmergencyCount);
    var readOnlyCount = detailed.Sum(server => server.DatabaseHealth!.ReadOnlyCount);
}

@if (Model.Any(server => server.Source != ServerDataSource.Demo))
{
    <div class="data-banner"><strong>MIXED DATABASE DATA</strong><span>The configured SQL Server uses cached database state facts; remaining cards are clearly separated development data. This page does not execute SQL directly.</span></div>
}
else
{
    <div class="data-banner"><strong>DEVELOPMENT DATA</strong><span>No real database snapshot is configured or available. Database availability values are preview data.</span></div>
}

<section class="health-command-summary">
    <article class="health-command-card hero state-@(unavailable > 0 ? "warning" : "healthy")">
        <div><small>DATABASE ESTATE AVAILABILITY</small><strong>@availability%</strong><span>@online of @total databases represented online</span></div>
        <div class="availability-orbit" style="--availability:@availability%"><b>@availability%</b></div>
    </article>
    <article class="health-command-card state-healthy"><small>ONLINE DATABASES</small><strong>@online</strong><span>Latest cached/read snapshot</span></article>
    <article class="health-command-card state-@(unavailable > 0 ? "critical" : "healthy")"><small>UNAVAILABLE</small><strong>@unavailable</strong><span>Require DBA attention</span></article>
    <article class="health-command-card state-@(impacted > 0 ? "warning" : "healthy")"><small>IMPACTED INSTANCES</small><strong>@impacted / @Model.Count</strong><span>@fullyOnline fully available</span></article>
    <article class="health-command-card state-@(offline > 0 ? "offline" : "healthy")"><small>UNREACHABLE INSTANCES</small><strong>@offline</strong><span>Snapshot cannot confirm DB state</span></article>
</section>

@if (detailed.Count > 0)
{
    <section class="health-command-summary">
        <article class="health-command-card state-@(suspectCount > 0 ? "critical" : "healthy")"><small>SUSPECT</small><strong>@suspectCount</strong><span>Real cached state count</span></article>
        <article class="health-command-card state-@(recoveryCount > 0 ? "warning" : "healthy")"><small>RECOVERY PIPELINE</small><strong>@recoveryCount</strong><span>Restoring / recovering / pending</span></article>
        <article class="health-command-card state-@(offlineDatabaseCount > 0 ? "critical" : "healthy")"><small>OFFLINE DATABASES</small><strong>@offlineDatabaseCount</strong><span>Explicit SQL state</span></article>
        <article class="health-command-card state-@(emergencyCount > 0 ? "critical" : "healthy")"><small>EMERGENCY</small><strong>@emergencyCount</strong><span>Explicit SQL state</span></article>
        <article class="health-command-card state-healthy"><small>READ-ONLY</small><strong>@readOnlyCount</strong><span>Configuration fact, not failure</span></article>
    </section>
}

<div class="section-heading">
    <div><span class="eyebrow">DATABASE OPERATIONS</span><h2>Availability by SQL instance</h2></div>
    <span class="snapshot-note">Snapshot-first view · browser filtering only</span>
</div>
<div class="health-toolbar">
    <div class="health-filter-group" aria-label="Database health filters">
        <button type="button" class="health-filter is-active" data-db-filter="all">All instances</button>
        <button type="button" class="health-filter" data-db-filter="attention">Needs attention</button>
        <button type="button" class="health-filter" data-db-filter="healthy">Fully online</button>
        <button type="button" class="health-filter" data-db-filter="critical">Unavailable DBs</button>
        <button type="button" class="health-filter" data-db-filter="offline">Offline</button>
    </div>
    <span class="snapshot-note">Availability lens only · detailed SQL states appear when collected</span>
</div>

<article class="glass-panel health-table-panel">
    <div class="panel-heading"><div><span class="eyebrow">DATABASE ESTATE</span><h3>Operational availability matrix</h3></div><span class="severity severity-@(unavailable > 0 ? "warning" : "healthy")">@unavailable unavailable</span></div>
    <div class="health-table">
        <div class="health-table-head"><span>Server</span><span>Version</span><span>Online</span><span>Total</span><span>Unavailable</span><span>Availability</span><span>DB State</span></div>
        @foreach (var server in Model)
        {
            var missing = server.DatabaseTotal - server.DatabaseOnline;
            var dbAvailability = server.DatabaseTotal == 0 ? 0 : (int)Math.Round((double)server.DatabaseOnline * 100 / server.DatabaseTotal);
            var detail = server.DatabaseHealth;
            var hasCriticalState = detail is not null && detail.CriticalCount > 0;
            var hasRecoveryState = detail is not null && detail.RecoveryCount > 0;
            var dbState = server.State == HealthState.Offline ? "offline" : hasCriticalState || missing > 0 ? "critical" : "healthy";
            var stateLabel = dbState == "offline"
                ? "Unknown"
                : hasCriticalState
                    ? "Critical state"
                    : hasRecoveryState
                        ? "Recovery"
                        : dbState == "healthy" ? "Online" : "Attention";
            <a class="health-table-row state-@dbState" data-db-row data-db-state="@dbState" asp-action="ServerDetails" asp-route-id="@server.Id">
                <strong>@server.Name</strong>
                <span>@server.Version</span>
                <span>@server.DatabaseOnline</span>
                <span>@server.DatabaseTotal</span>
                <span>@missing</span>
                <span class="availability-cell">
                    <div><small>@dbAvailability% available</small><small data-health-age="@server.LastScanSecondsAgo">@server.LastScanSecondsAgo sec ago</small></div>
                    <span class="micro-track"><span style="width:@dbAvailability%"></span></span>
                </span>
                <span class="severity severity-@dbState">@stateLabel</span>
            </a>
        }
    </div>
    <div class="health-empty" data-db-empty>No SQL instances match this local filter.</div>
</article>

<section class="db-insight-grid">
    <article class="glass-panel ops-panel">
        <div class="panel-heading"><div><span class="eyebrow">ATTENTION QUEUE</span><h3>What needs a database check?</h3></div><span class="snapshot-note">Derived from current cached snapshot</span></div>
        <div class="db-attention-list">
            @foreach (var server in Model.Where(item => item.State == HealthState.Offline || item.DatabaseOnline < item.DatabaseTotal))
            {
                var missing = server.DatabaseTotal - server.DatabaseOnline;
                var isOffline = server.State == HealthState.Offline;
                var detail = server.DatabaseHealth;
                var detailText = detail is null
                    ? $"{missing} database(s) are not represented online in the latest snapshot."
                    : $"{detail.SuspectCount} suspect · {detail.RecoveryCount} recovery · {detail.OfflineCount} offline · {detail.EmergencyCount} emergency.";
                <a class="db-attention-item state-@(isOffline ? "offline" : "critical")" asp-action="ServerDetails" asp-route-id="@server.Id">
                    <span>@(isOffline ? "×" : "!")</span>
                    <div><strong>@server.Name</strong><p>@(isOffline ? "Instance is unreachable; database availability is unknown until collection resumes." : detailText)</p></div>
                    <em>@(isOffline ? "UNKNOWN" : detail is null ? "CHECK DB" : "STATE DETAIL")</em>
                </a>
            }
            @if (!Model.Any(item => item.State == HealthState.Offline || item.DatabaseOnline < item.DatabaseTotal))
            {
                <div class="db-attention-item state-healthy"><span>✓</span><div><strong>No database availability exceptions</strong><p>Every represented database is online in the latest cached snapshot.</p></div><em>HEALTHY</em></div>
            }
        </div>
    </article>
    <article class="glass-panel ops-panel">
        <div class="panel-heading"><div><span class="eyebrow">DBA INTERPRETATION</span><h3>Database state projection</h3></div></div>
        <div class="policy-stack">
            <div class="policy-row"><small>Real detail</small><strong>@detailed.Count instance(s)</strong><span>Detailed state counts come from the same collector result as server identity and memory facts.</span></div>
            <div class="policy-row"><small>Collection source</small><strong>One shared SQL statement</strong><span>No per-database query and no independent Database Health collection call is introduced.</span></div>
            <div class="policy-row"><small>Cache boundary</small><strong>Read service only</strong><span>This page consumes fresh/stale cached snapshots and does not connect directly to monitored SQL Servers.</span></div>
            <div class="policy-row"><small>Read-only</small><strong>@readOnlyCount represented</strong><span>Read-only is surfaced as configuration context; it is not treated as an availability failure by itself.</span></div>
        </div>
    </article>
</section>
