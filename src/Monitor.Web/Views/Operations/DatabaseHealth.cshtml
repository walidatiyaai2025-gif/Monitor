@model IReadOnlyList<ServerCard>
@{
    ViewData["Title"] = "Database Health";
    var total = Model.Sum(server => server.DatabaseTotal);
    var online = Model.Sum(server => server.DatabaseOnline);
    var unavailable = total - online;
    var availability = total == 0 ? 0 : (int)Math.Round((double)online * 100 / total);
    var fullyOnline = Model.Count(server => server.DatabaseTotal > 0 && server.DatabaseOnline == server.DatabaseTotal && server.State != HealthState.Offline);
    var impacted = Model.Count(server => server.State == HealthState.Offline || server.DatabaseOnline < server.DatabaseTotal);
    var offline = Model.Count(server => server.State == HealthState.Offline);
}
<div class="data-banner"><strong>DEVELOPMENT DATA</strong><span>Database availability is rendered from the shared cached preview snapshot. No table or filter on this page executes SQL.</span></div>

<section class="health-command-summary">
    <article class="health-command-card hero state-@(unavailable > 0 ? "warning" : "healthy")">
        <div><small>DATABASE ESTATE AVAILABILITY</small><strong>@availability%</strong><span>@online of @total databases represented online</span></div>
        <div class="availability-orbit" style="--availability:@availability%"><b>@availability%</b></div>
    </article>
    <article class="health-command-card state-healthy"><small>ONLINE DATABASES</small><strong>@online</strong><span>Latest shared snapshot</span></article>
    <article class="health-command-card state-@(unavailable > 0 ? "critical" : "healthy")"><small>UNAVAILABLE</small><strong>@unavailable</strong><span>Require DBA attention</span></article>
    <article class="health-command-card state-@(impacted > 0 ? "warning" : "healthy")"><small>IMPACTED INSTANCES</small><strong>@impacted / @Model.Count</strong><span>@fullyOnline fully available</span></article>
    <article class="health-command-card state-@(offline > 0 ? "offline" : "healthy")"><small>UNREACHABLE INSTANCES</small><strong>@offline</strong><span>Snapshot cannot confirm DB state</span></article>
</section>

<div class="section-heading">
    <div><span class="eyebrow">DATABASE OPERATIONS</span><h2>Availability by SQL instance</h2></div>
    <span class="snapshot-note">Snapshot-first view · browser filtering only</span>
</div>
<div class="health-toolbar">
    <div class="health-filter-group" aria-label="Database health filters">
        <button type="button" class="health-filter is-active" data-db-filter="all">All instances</button>
        <button type="button" class="health-filter" data-db-filter="attention">Needs attention</button>
        <button type="button" class="health-filter" data-db-filter="healthy">Fully online</button>
        <button type="button" class="health-filter" data-db-filter="critical">Unavailable DBs</button>
        <button type="button" class="health-filter" data-db-filter="offline">Offline</button>
    </div>
    <span class="snapshot-note">Availability lens only · server health may include other warnings</span>
</div>

<article class="glass-panel health-table-panel">
    <div class="panel-heading"><div><span class="eyebrow">DATABASE ESTATE</span><h3>Operational availability matrix</h3></div><span class="severity severity-@(unavailable > 0 ? "warning" : "healthy")">@unavailable unavailable</span></div>
    <div class="health-table">
        <div class="health-table-head"><span>Server</span><span>Version</span><span>Online</span><span>Total</span><span>Unavailable</span><span>Availability</span><span>DB State</span></div>
        @foreach (var server in Model)
        {
            var missing = server.DatabaseTotal - server.DatabaseOnline;
            var dbAvailability = server.DatabaseTotal == 0 ? 0 : (int)Math.Round((double)server.DatabaseOnline * 100 / server.DatabaseTotal);
            var dbState = server.State == HealthState.Offline ? "offline" : missing > 0 ? "critical" : "healthy";
            <a class="health-table-row state-@dbState" data-db-row data-db-state="@dbState" asp-action="ServerDetails" asp-route-id="@server.Id">
                <strong>@server.Name</strong>
                <span>@server.Version</span>
                <span>@server.DatabaseOnline</span>
                <span>@server.DatabaseTotal</span>
                <span>@missing</span>
                <span class="availability-cell">
                    <div><small>@dbAvailability% available</small><small data-health-age="@server.LastScanSecondsAgo">@server.LastScanSecondsAgo sec ago</small></div>
                    <span class="micro-track"><span style="width:@dbAvailability%"></span></span>
                </span>
                <span class="severity severity-@dbState">@(dbState == "healthy" ? "Online" : dbState == "offline" ? "Unknown" : "Attention")</span>
            </a>
        }
    </div>
    <div class="health-empty" data-db-empty>No SQL instances match this local filter.</div>
</article>

<section class="db-insight-grid">
    <article class="glass-panel ops-panel">
        <div class="panel-heading"><div><span class="eyebrow">ATTENTION QUEUE</span><h3>What needs a database check?</h3></div><span class="snapshot-note">Derived from current snapshot</span></div>
        <div class="db-attention-list">
            @foreach (var server in Model.Where(item => item.State == HealthState.Offline || item.DatabaseOnline < item.DatabaseTotal))
            {
                var missing = server.DatabaseTotal - server.DatabaseOnline;
                var isOffline = server.State == HealthState.Offline;
                <a class="db-attention-item state-@(isOffline ? "offline" : "critical")" asp-action="ServerDetails" asp-route-id="@server.Id">
                    <span>@(isOffline ? "×" : "!")</span>
                    <div><strong>@server.Name</strong><p>@(isOffline ? "Instance is unreachable; database availability is unknown until collection resumes." : $"{missing} database(s) are not represented online in the latest snapshot.")</p></div>
                    <em>@(isOffline ? "UNKNOWN" : "CHECK DB")</em>
                </a>
            }
            @if (!Model.Any(item => item.State == HealthState.Offline || item.DatabaseOnline < item.DatabaseTotal))
            {
                <div class="db-attention-item state-healthy"><span>✓</span><div><strong>No database availability exceptions</strong><p>Every represented database is online in the latest cached snapshot.</p></div><em>HEALTHY</em></div>
            }
        </div>
    </article>
    <article class="glass-panel ops-panel">
        <div class="panel-heading"><div><span class="eyebrow">DBA INTERPRETATION</span><h3>Snapshot policy</h3></div></div>
        <div class="policy-stack">
            <div class="policy-row"><small>Availability lens</small><strong>Online vs represented total</strong><span>This page focuses on database reachability. Memory, jobs and backup health remain separate signals.</span></div>
            <div class="policy-row"><small>Collection source</small><strong>Shared server snapshot</strong><span>Multiple UI surfaces reuse one collected result rather than issuing independent SQL queries.</span></div>
            <div class="policy-row"><small>Refresh boundary</small><strong>Backend-controlled in M1</strong><span>Future manual refresh will be throttled and executed by the backend collector, never directly by the browser.</span></div>
        </div>
    </article>
</section>
