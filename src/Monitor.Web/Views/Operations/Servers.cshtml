@using Monitor.Web.Services
@model IReadOnlyList<ServerCard>
@{
    ViewData["Title"] = "Servers";
    var totalCount = ViewData["ServerTotal"] as int? ?? Model.Count;
    var offset = ViewData["ServerOffset"] as int? ?? 0;
    var limit = ViewData["ServerLimit"] as int? ?? Math.Max(1, Model.Count);
    var hasPrevious = ViewData["ServerHasPrevious"] as bool? ?? false;
    var hasNext = ViewData["ServerHasNext"] as bool? ?? false;
    var previousOffset = ViewData["ServerPreviousOffset"] as int? ?? 0;
    var nextOffset = ViewData["ServerNextOffset"] as int? ?? Math.Min(totalCount, offset + limit);
    var pageStart = totalCount == 0 ? 0 : offset + 1;
    var pageEnd = Math.Min(totalCount, offset + Model.Count);
    var healthyCount = Model.Count(server => server.State == HealthState.Healthy);
    var warningCount = Model.Count(server => server.State == HealthState.Warning);
    var criticalCount = Model.Count(server => server.State == HealthState.Critical);
    var offlineCount = Model.Count(server => server.State == HealthState.Offline);
    var reachableCount = Model.Count - offlineCount;
    var databaseOnline = Model.Sum(server => server.DatabaseOnline);
    var databaseTotal = Model.Sum(server => server.DatabaseTotal);
    var isDemoEstate = Model.All(server => server.Source == ServerDataSource.Demo);
    var demoJobsHealthy = Model.Sum(server => server.JobsHealthy ?? 0);
    var demoJobsTotal = Model.Sum(server => server.JobsTotal ?? 0);
    var liveAgentRows = Model.Where(server => (server.Source is ServerDataSource.LiveFresh or ServerDataSource.LiveStale) && server.JobsTotal.HasValue).ToArray();
    var liveAgentTotal = liveAgentRows.Sum(server => server.JobsTotal ?? 0);
    var liveAgentFailed = liveAgentRows.Sum(server => server.JobsFailedLastRun ?? 0);
    var policyStates = ViewData["ServerPolicyStates"] as IReadOnlyDictionary<Guid, ServerOperatorPolicyState>;
    var maintenanceCount = ViewData["MaintenanceActiveCount"] as int? ?? 0;
    var policyUnavailableCount = ViewData["OperatorPolicyUnavailableCount"] as int? ?? 0;
}

@if (Model.Any(server => server.Source != ServerDataSource.Demo))
{
    <div class="data-banner"><strong>REAL SQL ESTATE</strong><span>Cached SQL snapshots are shown only for this bounded estate page. Missing evidence is labeled explicitly; search, policy badges and freshness movement do not trigger collection.</span></div>
}
else
{
    <div class="data-banner"><strong>DEVELOPMENT DATA</strong><span>No live server is configured or available. Operational estate values are preview data.</span></div>
}

<section class="estate-summary">
    <article class="estate-summary-card state-healthy"><small>Reachable on page</small><strong>@reachableCount / @Model.Count</strong><span>Current bounded page only</span></article>
    <article class="estate-summary-card state-warning"><small>Needs attention</small><strong>@(warningCount + criticalCount)</strong><span>@warningCount warning · @criticalCount critical</span></article>
    <article class="estate-summary-card state-warning"><small>Maintenance</small><strong>@maintenanceCount</strong><span>Scheduled collection paused</span></article>
    <article class="estate-summary-card state-healthy"><small>Databases online</small><strong>@databaseOnline / @databaseTotal</strong><span>Current cached page</span></article>
    @if (isDemoEstate)
    {
        <article class="estate-summary-card state-warning"><small>Agent jobs healthy</small><strong>@demoJobsHealthy / @demoJobsTotal</strong><span>Development preview</span></article>
    }
    else
    {
        <article class="estate-summary-card state-warning"><small>Agent failed last run</small><strong>@(liveAgentRows.Length == 0 ? "Not collected" : $"{liveAgentFailed} / {liveAgentTotal}")</strong><span>Observed SQL Agent evidence only</span></article>
    }
    <article class="estate-summary-card state-offline"><small>Policy unavailable</small><strong>@policyUnavailableCount</strong><span>Scheduled collection fails closed</span></article>
</section>

<div class="section-heading">
    <div><span class="eyebrow">SQL ESTATE</span><h2>@totalCount monitored instances</h2><p>Showing @pageStart–@pageEnd of @totalCount · page limit @limit</p></div>
    @if (User.IsInRole(MonitorRoles.Administrator))
    {
        <a class="secondary-button" asp-controller="ConnectionLab" asp-action="Index">Manage targets</a>
    }
</div>

<section class="estate-tools" aria-label="Server estate filters">
    <div class="estate-filter-group">
        <button class="estate-filter is-active" type="button" data-estate-filter="all">Page · @Model.Count</button>
        <button class="estate-filter" type="button" data-estate-filter="healthy">Healthy · @healthyCount</button>
        <button class="estate-filter" type="button" data-estate-filter="warning">Warning · @warningCount</button>
        <button class="estate-filter" type="button" data-estate-filter="critical">Critical · @criticalCount</button>
        <button class="estate-filter" type="button" data-estate-filter="offline">Offline · @offlineCount</button>
    </div>
    <label class="estate-search"><input type="search" data-estate-search placeholder="Find server on this page…" autocomplete="off" /></label>
</section>

<section class="server-card-grid">
@foreach (var server in Model)
{
    var stateName = server.State.ToString().ToLowerInvariant();
    var healthScore = server.State switch
    {
        HealthState.Healthy => 96,
        HealthState.Warning => 72,
        HealthState.Critical => 41,
        HealthState.Offline => 0,
        _ => 50
    };
    var cpuState = !server.CpuPercent.HasValue ? "unknown" : server.State == HealthState.Offline ? "offline" : server.CpuPercent.Value >= 80 ? "warning" : "healthy";
    var memoryState = !server.MemoryPercent.HasValue ? "unknown" : server.State == HealthState.Offline ? "offline" : server.MemoryPercent.Value >= 82 ? "warning" : "healthy";
    var databaseState = server.DatabaseTotal == 0 ? "unknown" : server.DatabaseOnline == server.DatabaseTotal ? "healthy" : "critical";
    var jobsKnown = server.JobsTotal.HasValue && server.JobsEnabled.HasValue && server.JobsFailedLastRun.HasValue;
    var jobsState = server.Source == ServerDataSource.Demo
        ? server.JobsHealthy == server.JobsTotal ? "healthy" : "warning"
        : !jobsKnown ? "unknown" : server.JobsFailedLastRun.GetValueOrDefault() > 0 ? "warning" : "healthy";
    var registrationId = Guid.TryParse(server.Id, out var parsedId) ? parsedId : Guid.Empty;
    ServerOperatorPolicyState? operatorPolicy = null;
    var hasPolicy = registrationId != Guid.Empty && policyStates is not null && policyStates.TryGetValue(registrationId, out operatorPolicy);
    var ageLabel = server.Source == ServerDataSource.RegisteredUnavailable ? "Not collected" : $"{server.LastScanSecondsAgo} sec ago";
    var agentLabel = server.Source == ServerDataSource.Demo
        ? $"{server.JobsHealthy} / {server.JobsTotal} healthy"
        : jobsKnown
            ? $"{server.JobsEnabled} / {server.JobsTotal} enabled · {server.JobsFailedLastRun} failed last run"
            : "Not collected";

    <a class="server-card server-card-v2 glass-panel state-@stateName" data-server-card data-state="@stateName" data-name="@server.Name.ToLowerInvariant()" asp-action="ServerDetails" asp-route-id="@server.Id">
        <div class="server-card-v2-inner">
            <div class="server-card-head">
                <div><span class="health-orb state-@stateName"></span><span class="status-word">@server.State · @(server.Source switch { ServerDataSource.Demo => "DEMO", ServerDataSource.LiveFresh => "LIVE CACHED", ServerDataSource.LiveStale => "STALE CACHED", ServerDataSource.RegisteredUnavailable => "REGISTERED · NOT COLLECTED", _ => "UNKNOWN" })</span></div>
                <span class="snapshot-freshness"><span class="freshness-dot state-@stateName"></span><span class="snapshot-note" data-snapshot-age data-initial-age="@server.LastScanSecondsAgo">@ageLabel</span></span>
            </div>

            @if (hasPolicy && operatorPolicy is not null)
            {
                <div class="meta-line" aria-label="Collection policy">
                    @if (!operatorPolicy.PolicyReadable) { <span class="status-chip">POLICY UNAVAILABLE</span> }
                    else if (operatorPolicy.MaintenanceActive) { <span class="status-chip">MAINTENANCE · SCHEDULE PAUSED</span> }
                    @if (operatorPolicy.AlertSuppressed) { <span class="status-chip">ALERTS SUPPRESSED</span> }
                </div>
            }

            <div class="server-identity">
                <div><h3>@server.Name</h3><p>@server.Version · @server.Edition</p></div>
                <div class="health-score state-@stateName"><small>Health score</small><strong>@healthScore</strong></div>
            </div>
            <div class="pressure-grid">
                <div class="pressure-item state-@cpuState"><small>CPU</small><span class="pressure-track">@if (server.CpuPercent is int observedCpu) { <span style="width:@($"{observedCpu}%")"></span> }</span><strong>@(server.CpuPercent is int observedCpuValue ? $"{observedCpuValue}%" : "Not collected")</strong></div>
                <div class="pressure-item state-@memoryState"><small>Memory</small><span class="pressure-track">@if (server.MemoryPercent is int observedMemory) { <span style="width:@($"{observedMemory}%")"></span> }</span><strong>@(server.MemoryPercent is int observedMemoryValue ? $"{observedMemoryValue}%" : "Not collected")</strong></div>
            </div>
            <div class="server-compliance">
                <div class="compliance-cell state-@databaseState"><small>Database availability</small><strong>@(server.DatabaseTotal == 0 ? "Not collected" : $"{server.DatabaseOnline} / {server.DatabaseTotal} online")</strong></div>
                <div class="compliance-cell state-@jobsState"><small>SQL Agent</small><strong>@agentLabel</strong></div>
            </div>
            <div class="card-link"><span>Open operational overview</span><span>→</span></div>
        </div>
    </a>
}
</section>
<div class="empty-filter-state" data-estate-empty>No servers match the current local filter.</div>

@if (totalCount > limit)
{
    <div class="section-heading" aria-label="Server estate pagination">
        <div><span class="eyebrow">BOUNDED PAGE</span><p>Only this page is projected from cache. Navigation never triggers SQL collection.</p></div>
        <div>
            @if (hasPrevious) { <a class="secondary-button" asp-action="Servers" asp-route-offset="@previousOffset" asp-route-limit="@limit">← Previous</a> }
            @if (hasNext) { <a class="secondary-button" asp-action="Servers" asp-route-offset="@nextOffset" asp-route-limit="@limit">Next →</a> }
        </div>
    </div>
}
