@model IReadOnlyList<ServerCard>
@{
    ViewData["Title"] = "Memory Health";
    var observed = Model.Where(server => server.State != HealthState.Offline && server.MemoryPercent.HasValue).ToList();
    var averageMemory = observed.Count == 0 ? (int?)null : (int)Math.Round(observed.Average(server => server.MemoryPercent!.Value));
    var peakServer = observed.OrderByDescending(server => server.MemoryPercent!.Value).FirstOrDefault();
    var peakMemory = peakServer?.MemoryPercent;
    var pressureCount = observed.Count(server => server.MemoryPercent!.Value >= 85);
    var elevatedCount = observed.Count(server => server.MemoryPercent!.Value >= 75 && server.MemoryPercent!.Value < 85);
    var unknownCount = Model.Count(server => server.State == HealthState.Offline || !server.MemoryPercent.HasValue);
}
@if (Model.Any(server => server.Source != ServerDataSource.Demo))
{
    <div class="data-banner"><strong>REAL MEMORY DATA</strong><span>Only collected cached SQL/OS memory evidence is shown as a percentage. Missing memory evidence is labeled explicitly and visual gauges do not trigger SQL collection.</span></div>
}
else
{
    <div class="data-banner"><strong>DEVELOPMENT DATA</strong><span>No real memory snapshot is configured or available. Memory percentages are preview values.</span></div>
}

<section class="health-command-summary">
    <article class="health-command-card hero state-@(averageMemory.HasValue ? pressureCount > 0 ? "warning" : "healthy" : "unknown")">
        <div><small>ESTATE MEMORY PRESSURE</small><strong>@(averageMemory.HasValue ? $"{averageMemory.Value}%" : "Not collected")</strong><span>Average across @observed.Count observed instance(s)</span></div>
        <div class="availability-orbit" style="--availability:@(averageMemory ?? 0)%"><b>@(averageMemory.HasValue ? $"{averageMemory.Value}%" : "N/A")</b></div>
    </article>
    <article class="health-command-card state-@(peakMemory.HasValue ? peakMemory.Value >= 85 ? "warning" : "healthy" : "unknown")"><small>PEAK UTILIZATION</small><strong>@(peakMemory.HasValue ? $"{peakMemory.Value}%" : "Not collected")</strong><span>@(peakServer?.Name ?? "No observed instance")</span></article>
    <article class="health-command-card state-@(pressureCount > 0 ? "warning" : "healthy")"><small>PRESSURE ≥ 85%</small><strong>@pressureCount</strong><span>Observed threshold exceeded</span></article>
    <article class="health-command-card state-@(elevatedCount > 0 ? "warning" : "healthy")"><small>ELEVATED 75–84%</small><strong>@elevatedCount</strong><span>Observed watch list</span></article>
    <article class="health-command-card state-@(unknownCount > 0 ? "offline" : "healthy")"><small>UNKNOWN / OFFLINE</small><strong>@unknownCount</strong><span>No current memory evidence</span></article>
</section>

<div class="section-heading"><div><span class="eyebrow">MEMORY OPERATIONS</span><h2>Estate pressure map</h2></div><span class="snapshot-note">Current cached snapshot · threshold warning at 85%</span></div>

<section class="memory-command-grid">
    <article class="glass-panel memory-heatmap">
        <div class="panel-heading"><div><span class="eyebrow">INSTANCE HEATMAP</span><h3>Memory pressure by SQL Server</h3></div><span class="snapshot-note">Click a node for server context</span></div>
        <div class="memory-heat-grid">
            @foreach (var server in Model)
            {
                var isOffline = server.State == HealthState.Offline;
                var memoryKnown = !isOffline && server.MemoryPercent.HasValue;
                var memoryValue = server.MemoryPercent.GetValueOrDefault();
                var memoryState = isOffline ? "offline" : !memoryKnown ? "unknown" : memoryValue >= 85 ? "warning" : memoryValue >= 75 ? "warning" : "healthy";
                <a class="memory-node state-@memoryState @(isOffline ? "is-offline" : string.Empty)" asp-action="ServerDetails" asp-route-id="@server.Id">
                    <div class="memory-node-head">
                        <div><strong>@server.Name</strong><small>@server.Version · @server.Edition</small></div>
                        <b>@(memoryKnown ? $"{memoryValue}%" : "Not collected")</b>
                    </div>
                    <div class="memory-pressure-track">@if (memoryKnown) { <span style="width:@memoryValue%"></span> }</div>
                    <div class="memory-thresholds"><span>0</span><span>75 elevated</span><span>85 warning</span><span>100</span></div>
                    <div class="memory-node-footer">
                        <span class="memory-freshness"><i></i><span>@(isOffline ? "Snapshot unavailable" : memoryKnown ? "Memory evidence available" : "Memory not collected")</span></span>
                        <span data-health-age="@server.LastScanSecondsAgo">@(server.Source == ServerDataSource.RegisteredUnavailable ? "Not collected" : $"{server.LastScanSecondsAgo} sec ago")</span>
                    </div>
                </a>
            }
        </div>
    </article>

    <article class="glass-panel memory-diagnosis">
        <div class="panel-heading"><div><span class="eyebrow">PRESSURE INTERPRETATION</span><h3>DBA memory triage</h3></div></div>
        <div class="pressure-index">
            <div class="pressure-index-ring" style="--pressure:@(averageMemory ?? 0)%"><strong>@(averageMemory.HasValue ? $"{averageMemory.Value}%" : "N/A")</strong></div>
            <div><small>ESTATE PRESSURE INDEX</small><strong>@(!averageMemory.HasValue ? "Evidence unavailable" : pressureCount > 0 ? "Attention required" : elevatedCount > 0 ? "Elevated watch" : "Within observed threshold")</strong><span>Aggregate display only. Missing evidence is excluded rather than treated as zero.</span></div>
        </div>
        <div class="memory-legend">
            <div class="state-healthy"><small>NORMAL</small><strong>&lt; 75%</strong></div>
            <div class="state-warning"><small>ELEVATED</small><strong>75–84%</strong></div>
            <div class="state-warning"><small>WARNING</small><strong>≥ 85%</strong></div>
        </div>
        <div class="memory-insight-list">
            @foreach (var server in Model.OrderByDescending(item => item.State == HealthState.Offline || !item.MemoryPercent.HasValue ? 101 : item.MemoryPercent.Value))
            {
                var isOffline = server.State == HealthState.Offline;
                var memoryKnown = !isOffline && server.MemoryPercent.HasValue;
                var memoryValue = server.MemoryPercent.GetValueOrDefault();
                var needsAttention = isOffline || !memoryKnown || memoryValue >= 85;
                var state = isOffline ? "offline" : !memoryKnown ? "unknown" : memoryValue >= 85 ? "warning" : "healthy";
                <a class="memory-insight-item state-@state" asp-action="ServerDetails" asp-route-id="@server.Id">
                    <span>@(!memoryKnown ? "?" : memoryValue >= 85 ? "!" : "✓")</span>
                    <div><strong>@server.Name · @(!memoryKnown ? "Memory not collected" : $"{memoryValue}% used")</strong><p>@(isOffline ? "Restore collection before interpreting memory state." : !memoryKnown ? "This snapshot has no memory evidence; do not infer zero pressure." : memoryValue >= 85 ? "Inspect SQL max server memory, OS headroom and query workload under change control." : memoryValue >= 75 ? "Elevated but below warning threshold; watch trend and available OS memory." : "No observed memory pressure threshold is currently crossed.")</p></div>
                    <em>@(needsAttention ? "REVIEW" : "OK")</em>
                </a>
            }
        </div>
    </article>
</section>

<article class="glass-panel ops-panel">
    <div class="panel-heading"><div><span class="eyebrow">COLLECTION BOUNDARY</span><h3>What this screen diagnoses from bounded evidence</h3></div><span class="snapshot-note">Progressive enrichment</span></div>
    <div class="definition-grid">
        <div><small>SQL process memory</small><strong>Current snapshot</strong><span class="server-mini-note">Working set and SQL memory utilization when available.</span></div>
        <div><small>OS available memory</small><strong>Current snapshot</strong><span class="server-mini-note">Host headroom and system pressure when the collector returns memory evidence.</span></div>
        <div><small>Max server memory</small><strong>Planned</strong><span class="server-mini-note">Configuration vs physical memory.</span></div>
        <div><small>Memory clerks</small><strong>Planned</strong><span class="server-mini-note">Where SQL Server is consuming memory.</span></div>
        <div><small>PLE / grants</small><strong>Planned</strong><span class="server-mini-note">Pressure evidence and query grant stress.</span></div>
        <div><small>Recommendation</small><strong>Planned</strong><span class="server-mini-note">Evidence-backed DBA action and diagnostic query suggestion.</span></div>
    </div>
</article>
