@using Monitor.Web.Services
@model HealthModulePageViewModel
@{
    ViewData["Title"] = Model.Title;
    var observed = Model.Servers.Where(server => server.Memory is not null).ToArray();
    var averageMemory = observed.Length == 0 ? (int?)null : (int)Math.Round(observed.Average(server => server.Memory!.SqlProcessMemoryUtilizationPercent));
    var peakServer = observed.OrderByDescending(server => server.Memory!.SqlProcessMemoryUtilizationPercent).FirstOrDefault();
    var peakMemory = peakServer?.Memory?.SqlProcessMemoryUtilizationPercent;
    var pressureCount = observed.Count(server => MemoryIntelligenceProjection.Build(server.Memory).NeedsAttention);
    var grantsPendingCount = observed.Count(server => server.Memory!.MemoryGrantsPending is > 0);
    var unknownCount = Model.Servers.Count(server => server.Memory is null);
    var canManage = User.IsInRole(MonitorRoles.Administrator);
}

<partial name="_PortalPageHeader" model="@(new PortalPageHeaderViewModel(Model.Title, Model.Description, "CACHED MEMORY DIAGNOSTICS", "View servers", Url.Action("Servers", "Operations")))" />

@if (Model.Servers.Count == 0)
{
    <partial name="_PortalState" model="@(new PortalStateViewModel("No memory snapshots", "Collect a bounded server snapshot before interpreting memory health.", "warning", canManage ? "Manage connections" : "View servers", canManage ? Url.Action("Index", "ConnectionLab") : Url.Action("Servers", "Operations")))" />
}
else
{
    <section class="health-command-summary" aria-label="Memory health summary">
        <article class="health-command-card hero state-@(averageMemory.HasValue ? pressureCount > 0 ? "warning" : "healthy" : "unknown")">
            <div><small>ESTATE SQL MEMORY UTILIZATION</small><strong>@(averageMemory.HasValue ? $"{averageMemory.Value}%" : "Not collected")</strong><span>Average across @observed.Length server(s) with cached memory evidence</span></div>
        </article>
        <article class="health-command-card state-@(peakMemory is >= 85 ? "warning" : peakMemory.HasValue ? "healthy" : "unknown")"><small>PEAK UTILIZATION</small><strong>@(peakMemory.HasValue ? $"{peakMemory.Value}%" : "Not collected")</strong><span>@(peakServer?.Name ?? "No observed server")</span></article>
        <article class="health-command-card state-@(pressureCount > 0 ? "warning" : "healthy")"><small>NEEDS REVIEW</small><strong>@pressureCount</strong><span>Evidence-backed memory recommendation</span></article>
        <article class="health-command-card state-@(grantsPendingCount > 0 ? "warning" : "healthy")"><small>GRANTS PENDING</small><strong>@grantsPendingCount</strong><span>Server(s) reporting pending memory grants</span></article>
        <article class="health-command-card state-@(unknownCount > 0 ? "offline" : "healthy")"><small>EVIDENCE UNAVAILABLE</small><strong>@unknownCount</strong><span>Cached snapshot has no memory detail</span></article>
    </section>

    <section class="glass-panel table-panel health-surface-panel" style="margin-top:14px">
        <div class="panel-heading"><div><span class="eyebrow">MEMORY HEALTH BY SERVER</span><h3>Configuration, counters and dominant clerk</h3></div><span class="snapshot-note">GET reads cache only</span></div>
        <div class="responsive-table" role="region" aria-label="Memory health by server" tabindex="0">
            <div class="table-head health-detail-grid health-detail-grid-six" role="row"><span>Server</span><span>Source</span><span>SQL utilization</span><span>Max server memory</span><span>PLE / grants</span><span>Details</span></div>
            @foreach (var server in Model.Servers)
            {
                var memory = server.Memory;
                var intelligence = MemoryIntelligenceProjection.Build(memory);
                <div class="table-row health-detail-grid health-detail-grid-six" role="row">
                    <strong>@server.Name</strong>
                    <partial name="_HealthSourceBadge" model="server" />
                    <span class="state-@intelligence.State">@(memory is null ? "Not collected" : $"{memory.SqlProcessMemoryUtilizationPercent}%")</span>
                    <span>@(memory?.MaxServerMemoryMb is long maxMb ? $"{maxMb:N0} MB" : "Not collected")</span>
                    <span>@(memory?.PageLifeExpectancySeconds is long ple ? $"PLE {ple:N0}s" : "PLE Not collected") · @(memory?.MemoryGrantsPending is long grants ? $"grants {grants:N0}" : "grants Not collected")</span>
                    <a class="secondary-button compact-button" asp-controller="Operations" asp-action="ServerDetails" asp-route-id="@server.Id">Server</a>
                </div>
            }
        </div>
    </section>

    <section class="dashboard-grid" style="margin-top:14px" aria-label="Memory diagnostic evidence">
        @foreach (var server in Model.Servers)
        {
            var memory = server.Memory;
            var intelligence = MemoryIntelligenceProjection.Build(memory);
            <article class="glass-panel ops-panel state-@intelligence.State">
                <div class="panel-heading"><div><span class="eyebrow">@server.Name · MEMORY TRIAGE</span><h3>@(memory is null ? "Evidence unavailable" : intelligence.NeedsAttention ? "Review required" : "Observed state")</h3></div><span class="snapshot-note">@server.AgeSeconds sec old</span></div>
                @if (memory is null)
                {
                    <p class="panel-copy"><strong>Not collected.</strong> @intelligence.Recommendation</p>
                }
                else
                {
                    <div class="definition-grid">
                        <div><small>SQL process utilization</small><strong>@memory.SqlProcessMemoryUtilizationPercent%</strong><span class="server-mini-note">@((memory.SqlProcessPhysicalMemoryKb / 1024d / 1024d).ToString("0.0")) GB process physical memory</span></div>
                        <div><small>OS available memory</small><strong>@((memory.AvailablePhysicalMemoryKb / 1024d / 1024d).ToString("0.0")) GB</strong><span class="server-mini-note">@((memory.TotalPhysicalMemoryKb / 1024d / 1024d).ToString("0.0")) GB total physical memory</span></div>
                        <div><small>Max server memory</small><strong>@(memory.MaxServerMemoryMb is long maxMb ? $"{maxMb:N0} MB" : "Not collected")</strong><span class="server-mini-note">Configured value_in_use when exposed by the bounded collector.</span></div>
                        <div><small>Total / Target Server Memory</small><strong>@(memory.TotalServerMemoryKb is long totalKb ? $"{totalKb / 1024d:0} MB" : "Not collected") / @(memory.TargetServerMemoryKb is long targetKb ? $"{targetKb / 1024d:0} MB" : "Not collected")</strong><span class="server-mini-note">@(intelligence.TargetAttainmentPercent is int targetPercent ? $"Target attainment {targetPercent}%" : "Target attainment unavailable")</span></div>
                        <div><small>Page life expectancy</small><strong>@(memory.PageLifeExpectancySeconds is long ple ? $"{ple:N0} sec" : "Not collected")</strong><span class="server-mini-note">Evidence only; interpret against the workload baseline rather than a universal fixed threshold.</span></div>
                        <div><small>Memory grants pending</small><strong>@(memory.MemoryGrantsPending is long grants ? grants.ToString("N0") : "Not collected")</strong><span class="server-mini-note">Current Memory Manager counter when available.</span></div>
                        <div><small>Dominant memory clerk</small><strong>@intelligence.TopMemoryClerkLabel</strong><span class="server-mini-note">Largest clerk class by pages_kb; no allocation detail or SQL text is collected.</span></div>
                        <div><small>OS pressure flags</small><strong>@(memory.IsPhysicalMemoryLow || memory.IsVirtualMemoryLow ? "Pressure reported" : "No low-memory flag")</strong><span class="server-mini-note">@memory.SystemMemoryState</span></div>
                    </div>
                    <div class="data-banner" style="margin-top:12px"><strong>DBA RECOMMENDATION</strong><span>@intelligence.Recommendation</span></div>
                }
                <div style="margin-top:12px"><a class="secondary-button" asp-controller="Operations" asp-action="ServerDetails" asp-route-id="@server.Id">Open full server evidence</a></div>
            </article>
        }
    </section>

    <article class="glass-panel ops-panel" style="margin-top:14px">
        <div class="panel-heading"><div><span class="eyebrow">COLLECTION BOUNDARY</span><h3>Fully wired bounded memory diagnostics</h3></div><span class="snapshot-note">Snapshot-first</span></div>
        <div class="definition-grid">
            <div><small>SQL process memory</small><strong>Wired</strong><span class="server-mini-note">Working set and SQL process memory utilization.</span></div>
            <div><small>OS memory</small><strong>Wired</strong><span class="server-mini-note">Total/available memory plus low-memory flags and system state.</span></div>
            <div><small>Max server memory</small><strong>Wired</strong><span class="server-mini-note">Current configured value_in_use from sys.configurations.</span></div>
            <div><small>Total / Target memory</small><strong>Wired</strong><span class="server-mini-note">Memory Manager counters from the bounded snapshot.</span></div>
            <div><small>PLE / grants</small><strong>Wired</strong><span class="server-mini-note">Buffer Manager PLE and Memory Grants Pending when counters are exposed.</span></div>
            <div><small>Memory clerks</small><strong>Wired</strong><span class="server-mini-note">Dominant clerk class and size only; no SQL text or query plan.</span></div>
            <div><small>Recommendation</small><strong>Wired</strong><span class="server-mini-note">Deterministic evidence-backed guidance. No automatic tuning or configuration write.</span></div>
        </div>
    </article>

    <div class="data-banner"><strong>INTERPRETATION BOUNDARY</strong><span>All values are cached evidence. Missing counters remain Not collected. Opening Memory Health never contacts a monitored SQL Server and no recommendation executes a change.</span></div>
}
