@using Monitor.Web.Services
@model HealthModulePageViewModel
@{
    ViewData["Title"] = Model.Title;
    var observed = Model.Servers.Where(server => server.Backups is not null).ToArray();
    var missing = observed.Sum(server => server.Backups!.MissingFullBackupLast24Hours);
    var covered = observed.Sum(server => server.Backups!.BackedUpLast24Hours);
    var unavailable = Model.Servers.Count(server => server.Backups is null || server.Source == ServerDataSource.RegisteredUnavailable);
    var latestFull = observed.Select(server => server.Backups!.LastFullBackupAtUtc).Where(value => value.HasValue).Select(value => value!.Value).OrderByDescending(value => value).FirstOrDefault();
    var canManage = User.IsInRole(MonitorRoles.Administrator);
    var backupPolicy = ViewData["BackupPolicy"] as BackupPolicyOptions ?? new BackupPolicyOptions();
    var policyConfigured = backupPolicy.IsConfigured;
}

<partial name="_PortalPageHeader" model="@(new PortalPageHeaderViewModel(Model.Title, Model.Description + " This page never starts backup collection.", "CACHED BACKUP COVERAGE", "View servers", Url.Action("Servers", "Operations")))" />

<section class="health-command-summary" aria-label="Backup RPO policy">
    <article class="health-command-card hero state-@(policyConfigured ? "warning" : "offline")"><div><small>BACKUP RPO POLICY</small><strong>@(policyConfigured ? "Configured" : "Not configured")</strong><span>@(policyConfigured ? "Explicit operator policy; compliance is not evaluated from the current snapshot." : "Monitor does not assume Full or Log RPO values.")</span></div></article>
    <article class="health-command-card state-@(policyConfigured ? "warning" : "offline")"><small>FULL RPO</small><strong>@(policyConfigured ? $"{backupPolicy.FullRpoMinutes} min" : "Not configured")</strong><span>Must be supplied explicitly when BackupPolicy is enabled</span></article>
    <article class="health-command-card state-@(policyConfigured ? "warning" : "offline")"><small>LOG RPO</small><strong>@(policyConfigured ? $"{backupPolicy.LogRpoMinutes} min" : "Not configured")</strong><span>Used only after per-database recovery-model/log evidence exists</span></article>
    <article class="health-command-card state-warning"><small>B300 COMPLIANCE</small><strong>Not evaluated</strong><span>Recovery model and last log-backup evidence are not collected per database.</span></article>
</section>

@if (policyConfigured)
{
    <div class="data-banner"><strong>POLICY CONFIGURED · EVIDENCE INCOMPLETE</strong><span>Full RPO = @backupPolicy.FullRpoMinutes minutes and Log RPO = @backupPolicy.LogRpoMinutes minutes. These values are explicit configuration only. Monitor will not call the B300 backup-compliance classifier until the cached evidence contract includes per-database recovery model, full-backup time and log-backup time.</span></div>
}
else
{
    <div class="data-banner"><strong>RPO POLICY NOT CONFIGURED</strong><span>Monitor does not invent backup RPO values. Set BackupPolicy:Enabled=true with explicit positive FullRpoMinutes and LogRpoMinutes before policy evaluation can be considered.</span></div>
}

@if (Model.Servers.Count == 0)
{
    <partial name="_PortalState" model="@(new PortalStateViewModel("No backup snapshots", "Collect a server snapshot before interpreting backup coverage.", "warning", canManage ? "Manage connections" : "View servers", canManage ? Url.Action("Index", "ConnectionLab") : Url.Action("Servers", "Operations")))" />
}
else
{
    <section class="health-command-summary" aria-label="Backup health summary">
        <article class="health-command-card hero state-@(missing > 0 ? "critical" : unavailable > 0 ? "warning" : "healthy")"><div><small>24H FULL-BACKUP COVERAGE</small><strong>@covered covered</strong><span>@missing database(s) missing full-backup evidence</span></div></article>
        <article class="health-command-card state-@(missing > 0 ? "critical" : unavailable > 0 ? "warning" : "healthy")"><small>MISSING / 24H</small><strong>@missing</strong><span>@(unavailable > 0 ? $"{unavailable} server(s) also lack backup evidence" : "Collected databases without qualifying full backup")</span></article>
        <article class="health-command-card state-@(unavailable > 0 ? "offline" : "healthy")"><small>EVIDENCE UNAVAILABLE</small><strong>@unavailable</strong><span>Servers without backup evidence</span></article>
        <article class="health-command-card state-@(latestFull == default || unavailable > 0 ? "warning" : "healthy")"><small>LATEST FULL BACKUP</small><strong>@(latestFull == default ? "Not collected" : latestFull.ToString("u"))</strong><span>@(unavailable > 0 ? "Most recent timestamp among available cached evidence; estate evidence is incomplete" : "Most recent timestamp in cached evidence")</span></article>
    </section>

    <section class="glass-panel table-panel health-surface-panel">
        <div class="panel-heading"><div><span class="eyebrow">BACKUP COVERAGE BY SERVER</span><h3>Latest bounded backup facts</h3></div><span class="snapshot-note">Full backups only</span></div>
        <div class="responsive-table" role="region" aria-label="Backup health by server" tabindex="0">
            <div class="table-head health-detail-grid health-detail-grid-six" role="row"><span>Server</span><span>Source</span><span>Covered / 24h</span><span>Missing / 24h</span><span>Last full backup</span><span>Details</span></div>
            @foreach (var server in Model.Servers)
            {
                var backup = server.Backups;
                <div class="table-row health-detail-grid health-detail-grid-six" role="row">
                    <strong>@server.Name</strong>
                    <partial name="_HealthSourceBadge" model="server" />
                    <span>@(backup is null ? "Not collected" : backup.BackedUpLast24Hours)</span>
                    <span class="@(backup?.MissingFullBackupLast24Hours > 0 ? "state-critical" : string.Empty)">@(backup is null ? "Not collected" : backup.MissingFullBackupLast24Hours)</span>
                    <span>@(backup?.LastFullBackupAtUtc?.ToString("u") ?? "Not collected")</span>
                    <a class="secondary-button compact-button" asp-controller="Operations" asp-action="ServerDetails" asp-route-id="@server.Id">Server</a>
                </div>
            }
        </div>
    </section>
    <div class="data-banner"><strong>INTERPRETATION BOUNDARY</strong><span>Missing full-backup evidence is not the same as backup failure. This screen shows only cached full-backup coverage returned by the collector. Even when an RPO policy is configured, it does not claim B300 RPO compliance because per-database recovery-model and log-backup evidence are not collected here.</span></div>
}
