@using Monitor.Web.Services
@model HealthModulePageViewModel
@{
    ViewData["Title"] = Model.Title;
    var observed = Model.Servers.Where(server => server.Jobs is not null).ToArray();
    var totalJobs = observed.Sum(server => server.Jobs!.TotalJobs);
    var enabledJobs = observed.Sum(server => server.Jobs!.EnabledJobs);
    var failedJobs = observed.Sum(server => server.Jobs!.FailedLastRun);
    var unavailable = Model.Servers.Count(server => server.Jobs is null || server.Source == ServerDataSource.RegisteredUnavailable);
    var reliability = Model.Servers
        .SelectMany(server => AgentReliabilityProjection.Build(server.Jobs).Select(item => new { Server = server, Item = item }))
        .ToArray();
    var alertWorthy = reliability.Count(item => item.Item.AlertWorthy);
    var topRisk = reliability.OrderByDescending(item => item.Item.Score).ThenBy(item => item.Item.JobKey).FirstOrDefault();
    var historyUnavailable = Model.Servers.Count(server => server.Jobs?.RecentRuns is not { Count: > 0 });
    var scheduleUnavailable = Model.Servers.Count(server => server.Jobs?.Schedules is not { Count: > 0 });
    var scheduleRows = Model.Servers.Sum(server => server.Jobs?.Schedules?.Count ?? 0);
    var runningObserved = Model.Servers.Sum(server => server.Jobs?.Schedules?.Count(item => item.IsRunning) ?? 0);
    var canManage = User.IsInRole(MonitorRoles.Administrator);
}

<partial name="_PortalPageHeader" model="@(new PortalPageHeaderViewModel(Model.Title, Model.Description + " Recent run-history reliability and current Agent activity use bounded metadata only; job commands and step text are never collected.", "CACHED SQL AGENT RELIABILITY", "View servers", Url.Action("Servers", "Operations")))" />

@if (Model.Servers.Count == 0)
{
    <partial name="_PortalState" model="@(new PortalStateViewModel("No SQL Agent snapshots", "Collect a server snapshot before interpreting SQL Agent outcomes.", "warning", canManage ? "Manage connections" : "View servers", canManage ? Url.Action("Index", "ConnectionLab") : Url.Action("Servers", "Operations")))" />
}
else
{
    <section class="health-command-summary" aria-label="SQL Agent health summary">
        <article class="health-command-card hero state-@(failedJobs > 0 || alertWorthy > 0 ? "critical" : unavailable > 0 ? "warning" : "healthy")"><div><small>SQL AGENT ESTATE</small><strong>@totalJobs jobs</strong><span>@enabledJobs enabled · @failedJobs failed last run · @alertWorthy reliability alerts</span></div></article>
        <article class="health-command-card state-@(unavailable > 0 ? "warning" : "healthy")"><small>ENABLED</small><strong>@enabledJobs</strong><span>Enabled jobs in collected snapshots</span></article>
        <article class="health-command-card state-@(failedJobs > 0 ? "critical" : unavailable > 0 ? "warning" : "healthy")"><small>FAILED LAST RUN</small><strong>@failedJobs</strong><span>Aggregate last-outcome evidence</span></article>
        <article class="health-command-card state-@(alertWorthy > 0 ? "warning" : historyUnavailable > 0 ? "warning" : "healthy")"><small>RUN-HISTORY RISK</small><strong>@alertWorthy</strong><span>@(topRisk is null ? (historyUnavailable > 0 ? $"History unavailable on {historyUnavailable} server(s)" : "No reliability alerts in retained history") : $"Top: {topRisk.Server.Name} · {topRisk.Item.JobKey} · score {topRisk.Item.Score:0.##}")</span></article>
        <article class="health-command-card state-@(scheduleUnavailable > 0 ? "warning" : "healthy")"><small>CURRENT AGENT ACTIVITY</small><strong>@scheduleRows rows</strong><span>@runningObserved running · server-local next-run metadata · @scheduleUnavailable server(s) without retained activity</span></article>
        <article class="health-command-card state-@(unavailable > 0 ? "offline" : "healthy")"><small>EVIDENCE UNAVAILABLE</small><strong>@unavailable</strong><span>Servers without aggregate SQL Agent evidence</span></article>
    </section>

    <section class="glass-panel table-panel health-surface-panel">
        <div class="panel-heading"><div><span class="eyebrow">SQL AGENT BY SERVER</span><h3>Latest aggregate job outcomes</h3></div><span class="snapshot-note">No commands or step text collected</span></div>
        <div class="responsive-table" role="region" aria-label="SQL Agent health by server" tabindex="0">
            <div class="table-head health-detail-grid health-detail-grid-six" role="row"><span>Server</span><span>Source</span><span>Total jobs</span><span>Enabled</span><span>Failed last run</span><span>Details</span></div>
            @foreach (var server in Model.Servers)
            {
                var jobs = server.Jobs;
                <div class="table-row health-detail-grid health-detail-grid-six" role="row">
                    <strong>@server.Name</strong>
                    <partial name="_HealthSourceBadge" model="server" />
                    <span>@(jobs is null ? "Not collected" : jobs.TotalJobs)</span>
                    <span>@(jobs is null ? "Not collected" : jobs.EnabledJobs)</span>
                    <span class="@(jobs?.FailedLastRun > 0 ? "state-critical" : string.Empty)">@(jobs is null ? "Not collected" : jobs.FailedLastRun)</span>
                    <a class="secondary-button compact-button" asp-controller="Operations" asp-action="ServerDetails" asp-route-id="@server.Id">Server</a>
                </div>
            }
        </div>
    </section>

    <section class="dashboard-grid" style="margin-top:14px" aria-label="SQL Agent reliability by server">
        @foreach (var server in Model.Servers)
        {
            var jobs = AgentReliabilityProjection.Build(server.Jobs);
            var scheduleEvidence = server.Jobs?.Schedules ?? [];
            var top = jobs.FirstOrDefault();
            var state = top?.Severity switch
            {
                B400Severity.Critical => "critical",
                B400Severity.Warning => "warning",
                B400Severity.Info => "warning",
                _ => jobs.Count == 0 || scheduleEvidence.Count == 0 ? "warning" : "healthy"
            };
            <article class="glass-panel ops-panel state-@state">
                <div class="panel-heading"><div><span class="eyebrow">@server.Name · B400 AGENT RELIABILITY</span><h3>Recent outcomes, duration regression and current activity</h3></div><span class="snapshot-note">max 50 history + 50 activity rows/server</span></div>
                @if (jobs.Count == 0)
                {
                    <p class="panel-copy"><strong>Run history: Not collected.</strong> Recent SQL Agent summary-run history is unavailable. No reliable/healthy job state is inferred from an empty history set.</p>
                }
                else
                {
                    <div class="responsive-table" role="region" aria-label="@server.Name SQL Agent reliability" tabindex="0">
                        <div class="table-head health-detail-grid health-detail-grid-six" role="row"><span>Job</span><span>Owner</span><span>Success</span><span>Failure streak</span><span>P95 duration</span><span>Score</span></div>
                        @foreach (var job in jobs)
                        {
                            <div class="table-row health-detail-grid health-detail-grid-six" role="row">
                                <strong>@job.JobKey</strong>
                                <span>@job.Owner</span>
                                <span>@job.SuccessRatePercent.ToString("0.##")%</span>
                                <span class="@(job.FailureStreak > 0 ? "state-warning" : string.Empty)">@job.FailureStreak</span>
                                <span>@job.P95Duration.TotalSeconds.ToString("0.##") sec · Δ @job.DurationRegressionPercent.ToString("0.##")%</span>
                                <span class="state-@(job.Severity is B400Severity.Critical ? "critical" : job.Severity is B400Severity.Warning ? "warning" : "healthy")">@job.Score.ToString("0.##") · @job.Severity</span>
                            </div>
                        }
                    </div>
                    <p class="server-mini-note">Reliability uses bounded recent summary-run outcomes and durations. Schedule lateness remains <strong>not evaluated</strong>; the reliability score still excludes lateness rather than substituting a fake value.</p>
                }

                <div class="panel-heading" style="margin-top:14px"><div><span class="eyebrow">CURRENT AGENT ACTIVITY</span><h3>Next scheduled run evidence</h3></div><span class="snapshot-note">server-local wall clock</span></div>
                @if (scheduleEvidence.Count == 0)
                {
                    <p class="panel-copy"><strong>Schedule activity: Not collected.</strong> Current SQL Agent activity evidence is unavailable. No late/on-time state is inferred.</p>
                }
                else
                {
                    <div class="responsive-table" role="region" aria-label="@server.Name current SQL Agent activity" tabindex="0">
                        <div class="table-head health-detail-grid" role="row"><span>Job</span><span>Next scheduled run</span><span>Running</span><span>Clock</span><span>Interpretation</span><span>Source</span><span>Details</span></div>
                        @foreach (var activity in scheduleEvidence.OrderBy(item => item.NextScheduledRunLocal is null).ThenBy(item => item.NextScheduledRunLocal).ThenBy(item => item.JobKey, StringComparer.OrdinalIgnoreCase))
                        {
                            <div class="table-row health-detail-grid" role="row">
                                <strong>@activity.JobKey</strong>
                                <span>@(activity.NextScheduledRunLocal?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Not scheduled")</span>
                                <span class="@(activity.IsRunning ? "state-warning" : string.Empty)">@(activity.IsRunning ? "Running" : "Not running")</span>
                                <span>Server local</span>
                                <span>Evidence only · lateness not evaluated</span>
                                <span>Cached sysjobactivity</span>
                                <a class="secondary-button compact-button" asp-controller="Operations" asp-action="ServerDetails" asp-route-id="@server.Id">Server</a>
                            </div>
                        }
                    </div>
                    <p class="server-mini-note">`next_scheduled_run_date` is retained as SQL Server Agent server-local wall-clock evidence. The snapshot does not carry a canonical server time-zone identity or recurrence/expected-run policy, so this page intentionally does not convert the value to UTC or classify it as late/on-time.</p>
                }
                <div style="margin-top:12px"><a class="secondary-button" asp-controller="Operations" asp-action="ServerDetails" asp-route-id="@server.Id">Open full server evidence</a></div>
            </article>
        }
    </section>

    <div class="data-banner"><strong>COLLECTION BOUNDARY</strong><span>Up to 50 recent SQL Agent job-summary history rows and 50 current Agent activity rows are cached per server. History contains logical job name, owner, outcome, run ordering key and duration. Current activity contains logical job name, server-local next scheduled run and a running flag. Step rows, commands, command text, recurrence definitions, proxies and credentials are not collected. GET navigation does not contact monitored SQL.</span></div>
}
