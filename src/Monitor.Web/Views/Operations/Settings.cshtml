@model SettingsViewModel
@{
    ViewData["Title"] = "Settings";
    var credential = Model.CredentialReadiness ?? new Monitor.Web.Services.CredentialReadinessViewModel(Monitor.Web.Services.DataProtectionKeyStoreMode.LocalFile, false, 0, 0, 0, false, "HA credential readiness unavailable", "Credential readiness service is unavailable.");
    var backup = Model.BackupReadiness;
}

<partial name="_PortalPageHeader" model="@(new PortalPageHeaderViewModel("Administrator Settings", "Production-readiness state and guarded control-plane backup/recovery actions, grouped by deployment, credentials, recovery and runtime boundaries.", "ADMINISTRATOR SETTINGS", "Readiness", Url.Action("Readiness", "EnterpriseHelp")))" />

@if (TempData["BackupStatus"] is string backupStatus)
{
    <div class="lab-success" role="status" aria-live="polite"><span>✓</span><strong>@backupStatus</strong></div>
}

<nav class="settings-jump-nav glass-panel" aria-label="Settings sections">
    <a href="#settings-deployment">Deployment</a>
    <a href="#settings-state">Shared state</a>
    <a href="#settings-credentials">Credentials</a>
    @if (backup is not null) { <a href="#settings-backup">Backup & restore</a> }
    <a href="#settings-runtime">Runtime</a>
    <a href="#settings-security">Security</a>
</nav>

<section class="settings-section" aria-labelledby="settings-foundation-title">
    <div class="section-heading"><div><span class="eyebrow">PRODUCTION FOUNDATION</span><h2 id="settings-foundation-title">Deployment, state & credential readiness</h2></div><span class="snapshot-note">Read-only readiness</span></div>
    <div class="settings-grid">
        <article id="settings-deployment" class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">DEPLOYMENT TOPOLOGY</span><h3>HA readiness guard</h3></div><span class="snapshot-note">@Model.Deployment.Status</span></div><label>Configured mode<div class="fake-input">@Model.Deployment.Mode <span>@Model.Deployment.Status</span></div></label><label>Multi-node readiness<div class="fake-input">@(Model.Deployment.Mode == Monitor.Web.Services.DeploymentTopology.MultiNode ? "Requested" : "Cross-field gate armed") <span>@(Model.Deployment.Ready ? "Safe for selected mode" : "Blocked")</span></div></label><p>@Model.Deployment.Message</p><div class="lab-rule state-warning"><span>!</span><div><strong>Node-local state still present</strong><p>@string.Join(" · ", Model.Deployment.NodeLocalState)</p></div></div></article>

        <article id="settings-state" class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">SHARED STATE</span><h3>Dedicated Monitor state provider</h3></div><span class="snapshot-note">@Model.SharedState.Status</span></div><label>Provider<div class="fake-input">@Model.SharedState.Provider <span>@Model.SharedState.Status</span></div></label><label>Schema<div class="fake-input">@(Model.SharedState.SchemaVersion?.ToString() ?? "Not available") <span>Required v1</span></div></label><label>Shared storage capability<div class="fake-input">@(Model.SharedState.SharedStorageReady ? "READY" : "NOT READY") <span>Monitor-owned DB only</span></div></label><p>@Model.SharedState.Message</p><small>Provider endpoint and credentials are intentionally omitted.</small></article>

        <article id="settings-credentials" class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">CREDENTIAL HA</span><h3>Key ring & SQL Login references</h3></div><span class="snapshot-note">@credential.Status</span></div><label>Data Protection key ring<div class="fake-input">@credential.KeyRingMode <span>@(credential.SharedKeyRingReady ? "Shared encrypted" : "Node-local")</span></div></label><label>SQL Login profiles<div class="fake-input">@credential.SqlLoginRegistrations <span>@credential.ExternalRegistrations external</span></div></label><label>Monitor-owned local references<div class="fake-input">@credential.LocalOwnedRegistrations <span>@(credential.LocalOwnedRegistrations == 0 ? "Clear" : "Migration required")</span></div></label><label>Multi-node credential gate<div class="fake-input">@(credential.MultiNodeCredentialReady ? "READY" : "BLOCKED") <span>@credential.Status</span></div></label><p>@credential.Message</p><small>No secret reference, SQL username, provider endpoint, connection string or key-encryption key is rendered.</small></article>
    </div>
</section>

@if (backup is not null)
{
    <section class="settings-section" aria-labelledby="settings-recovery-title">
        <div class="section-heading"><div><span class="eyebrow">RECOVERY</span><h2 id="settings-recovery-title">Operational backup & restore</h2></div><span class="snapshot-note">Administrator POST actions</span></div>
        <div class="settings-grid settings-grid-single">
            <article id="settings-backup" class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">OPERATIONAL BACKUP</span><h3>Backup / restore readiness</h3></div><span class="snapshot-note">@backup.Status</span></div><label>Retained backups<div class="fake-input">@backup.BackupCount <span>@(backup.LatestBackupUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "None yet")</span></div></label><label>Restore behavior<div class="fake-input">@(backup.RestoreRequiresRestart ? "Restart required" : "Live shared-state reload") <span>@(backup.Ready ? "Available" : "Blocked")</span></div></label><p>@backup.Message</p>
                <form asp-controller="OperationalBackup" asp-action="CreateBackup" method="post" class="lab-test"><span>Export registrations, incidents, history and audit with SHA-256 checksums. Secret ciphertext and Data Protection keys are excluded.</span><button class="primary-button" type="submit">Create operational backup</button></form>
                @foreach (var item in backup.RecentBackups)
                {
                    <div class="lab-rule state-healthy"><span>BK</span><div><strong>@item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @(Math.Max(1, item.SizeBytes / 1024)) KB</strong><p>Backup ID @item.BackupId</p><div class="backup-actions"><form asp-controller="OperationalBackup" asp-action="ValidateBackup" asp-route-backupId="@item.BackupId" method="post"><button class="secondary-button" type="submit">Dry-run validate</button></form>@if (backup.Ready){<form asp-controller="OperationalBackup" asp-action="RestoreBackup" asp-route-backupId="@item.BackupId" method="post" autocomplete="off"><label class="sr-only" for="restore-@item.BackupId">Type RESTORE to confirm</label><input id="restore-@item.BackupId" name="confirmation" maxlength="7" placeholder="type RESTORE" /><button class="secondary-button" type="submit">Restore validated state</button></form>}</div></div></div>
                }
                <small>Restore is Administrator-only, POST + antiforgery protected, checksum validated and rollback-capable. File-backed restore requires an application restart before operations resume.</small>
            </article>
        </div>
    </section>
}

<section class="settings-section" aria-labelledby="settings-boundaries-title">
    <div class="section-heading"><div><span class="eyebrow">RUNTIME BOUNDARIES</span><h2 id="settings-boundaries-title">Collection & security contracts</h2></div><span class="snapshot-note">Non-secret configuration</span></div>
    <div class="settings-grid">
        <article id="settings-runtime" class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">COLLECTION</span><h3>Snapshot policy</h3></div></div><label>Monitoring GET behavior<div class="fake-input">Cache Peek only <span>Zero SQL</span></div></label><label>Manual refresh<div class="fake-input">Operator/Admin POST <span>Distributed single-flight capable</span></div></label><p>Browser navigation reads cached monitored-SQL evidence only. Control-plane backup/coordination never targets a monitored SQL registration.</p></article>
        <article id="settings-security" class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">SECURITY</span><h3>Credential boundaries</h3></div></div><label>Development Admin<div class="fake-input">PBKDF2-SHA256 hash <span>120k iterations</span></div></label><label>SQL Login values<div class="fake-input">Write-only / external references <span>No backup payloads</span></div></label><p>Operational backups contain safe metadata and opaque secret references only. Protected credential ciphertext, Data Protection key material and provider connection values are excluded by contract.</p></article>
    </div>
</section>
