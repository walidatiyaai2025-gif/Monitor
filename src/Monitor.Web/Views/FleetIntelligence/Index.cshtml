@using Monitor.Web.Services
@model FleetIntelligenceSnapshot
@{ ViewData["Title"] = "Fleet Intelligence"; }

<partial name="_PortalPageHeader" model="@(new PortalPageHeaderViewModel("Fleet Intelligence", "Estate rollups calculated from registrations, operator policy, incidents and snapshot-cache Peek only. This page never initiates monitored SQL collection.", "CACHE-ONLY FLEET", "Enterprise Operations", Url.Action("Overview", "EnterpriseOperations")))" />

<section class="health-command-summary" aria-label="Fleet cache summary">
    <article class="health-command-card state-healthy"><small>FRESH</small><strong>@Model.Fresh</strong><span>Cached snapshots</span></article>
    <article class="health-command-card state-@(Model.Stale > 0 ? "warning" : "healthy")"><small>STALE</small><strong>@Model.Stale</strong><span>Outside fresh window</span></article>
    <article class="health-command-card state-@(Model.Unavailable > 0 ? "offline" : "healthy")"><small>UNAVAILABLE</small><strong>@Model.Unavailable</strong><span>No cached snapshot</span></article>
    <article class="health-command-card state-@(!Model.ServerPolicyEvidenceComplete || Model.Maintenance > 0 ? "warning" : "healthy")"><small>MAINTENANCE</small><strong>@(Model.ServerPolicyEvidenceComplete ? Model.Maintenance.ToString() : "—")</strong><span>@(Model.ServerPolicyEvidenceComplete ? "Scheduled collection paused" : "Operator policy unavailable")</span></article>
    <article class="health-command-card state-@(!Model.ServerPolicyEvidenceComplete || Model.Suppressed > 0 ? "warning" : "healthy")"><small>SUPPRESSED</small><strong>@(Model.ServerPolicyEvidenceComplete ? Model.Suppressed.ToString() : "—")</strong><span>@(Model.ServerPolicyEvidenceComplete ? "Alert actionability only" : "Operator policy unavailable")</span></article>
</section>

@if (!Model.ServerPolicyEvidenceComplete)
{
    <section class="glass-panel state-warning" aria-label="Fleet operator policy evidence unavailable">
        <div class="panel-heading"><div><span class="eyebrow">OPERATOR POLICY EVIDENCE</span><h3>Some fleet policy facts are unavailable</h3></div><span class="status-chip">@Model.OperatorPolicyUnavailable UNAVAILABLE</span></div>
        <p>Environment, group and tag buckets include only servers whose operator policy metadata was readable. Fleet maintenance and suppression totals are withheld rather than treating unavailable metadata as default values.</p>
        <p class="snapshot-note">Cached health, risk and advanced diagnostic evidence remains visible because those facts do not require operator metadata.</p>
    </section>
}

<section class="dashboard-grid fleet-drill-grid">
    <article class="glass-panel"><div class="panel-heading"><div><span class="eyebrow">ENVIRONMENT</span><h3>Health by environment</h3></div></div><div class="fleet-bucket-list">@foreach (var bucket in Model.ByEnvironment) { <a asp-controller="EnterpriseOperations" asp-action="Overview" asp-route-environment="@bucket.Key"><strong>@bucket.Key</strong><span>@bucket.Servers servers · @bucket.Fresh fresh · @bucket.Stale stale · @bucket.Unavailable unavailable · @bucket.Maintenance maintenance</span><small>Open filtered enterprise operations →</small></a> }@if (Model.ByEnvironment.Count == 0) { <span class="empty-state">@(Model.ServerPolicyEvidenceComplete ? "No environment buckets." : "Environment buckets are unavailable until operator policy metadata is readable.")</span> }</div></article>
    <article class="glass-panel"><div class="panel-heading"><div><span class="eyebrow">GROUP</span><h3>Health by group</h3></div></div><div class="fleet-bucket-list">@foreach (var bucket in Model.ByGroup) { <a asp-controller="EnterpriseOperations" asp-action="Overview" asp-route-group="@bucket.Key"><strong>@bucket.Key</strong><span>@bucket.Servers servers · @bucket.Fresh fresh · @bucket.Suppressed suppressed</span><small>Open filtered enterprise operations →</small></a> }@if (Model.ByGroup.Count == 0) { <span class="empty-state">@(Model.ServerPolicyEvidenceComplete ? "No group buckets." : "Group buckets are unavailable until operator policy metadata is readable.")</span> }</div></article>
    <article class="glass-panel"><div class="panel-heading"><div><span class="eyebrow">TAG</span><h3>Health by tag</h3></div></div><div class="fleet-bucket-list">@foreach (var bucket in Model.ByTag) { <a asp-controller="EnterpriseOperations" asp-action="Overview" asp-route-tag="@bucket.Key"><strong>@bucket.Key</strong><span>@bucket.Servers servers · @bucket.Unavailable unavailable</span><small>Open filtered enterprise operations →</small></a> }@if (Model.ByTag.Count == 0) { <span class="empty-state">@(Model.ServerPolicyEvidenceComplete ? "No tag buckets." : "Tag buckets are unavailable until operator policy metadata is readable.")</span> }</div></article>
    <article class="glass-panel"><div class="panel-heading"><div><span class="eyebrow">RISK</span><h3>Cached risk signals</h3></div></div><div class="fleet-risk-links"><a asp-controller="Operations" asp-action="Backups"><small>Backup gaps</small><strong>@Model.Risks.BackupGaps</strong></a><a asp-controller="Operations" asp-action="MemoryHealth"><small>Memory pressure</small><strong>@Model.Risks.MemoryPressure</strong></a><a asp-controller="Operations" asp-action="Blocking"><small>Blocking risk</small><strong>@Model.Risks.BlockingRisk</strong></a><a asp-controller="Portal" asp-action="Performance"><small>Runnable pressure</small><strong>@Model.Risks.RunnableRisk</strong></a></div></article>
</section>

@if (Model.Advanced is { } advanced)
{
    <section class="glass-panel" aria-label="Advanced evidence coverage">
        <div class="panel-heading"><div><span class="eyebrow">BOUNDED EVIDENCE</span><h3>Advanced diagnostic coverage</h3></div><span class="snapshot-note">Facts only · no composite readiness claim</span></div>
        <div class="fleet-risk-links">
            <a asp-controller="Operations" asp-action="Storage"><small>TempDB evidence</small><strong>@advanced.TempDbServers servers</strong></a>
            <a asp-controller="Operations" asp-action="DatabaseHealth"><small>Transaction-log evidence</small><strong>@advanced.TransactionLogServers servers</strong></a>
            <a asp-controller="Operations" asp-action="DatabaseHealth"><small>HA evidence</small><strong>@advanced.HaEnabledServers enabled / @advanced.HaServers observed</strong></a>
            <a asp-controller="Operations" asp-action="DatabaseHealth"><small>Reuse blocked</small><strong>@advanced.LogReuseBlockedDatabases databases</strong></a>
            <a asp-controller="Operations" asp-action="DatabaseHealth"><small>HA suspended</small><strong>@advanced.SuspendedHaDatabases databases</strong></a>
            <span><small>Stale advanced evidence</small><strong>@advanced.StaleEvidenceServers servers</strong></span>
        </div>
        <p class="snapshot-note">TempDB growth/contention, transaction-log composite score, and HA quorum/RPO/RTO remain not evaluated until their missing evidence or policy inputs exist.</p>
    </section>
}

@if (!Model.IncidentEvidenceComplete)
{
    <section class="glass-panel state-warning" aria-label="Fleet incident evidence unavailable">
        <div class="panel-heading"><div><span class="eyebrow">INCIDENT EVIDENCE</span><h3>Fleet decision support not evaluated</h3></div><span class="status-chip">BOUNDED @Model.IncidentEvidenceLimit</span></div>
        <p>Active incident evidence for the enabled fleet exceeded the bounded decision-read limit. Correlation clusters, routing recommendations, and rule hot-spots are withheld rather than calculated from a partial incident set.</p>
        <p class="snapshot-note">The legacy incident store may contain more rows; B800-073 bounds operator decision inputs and exposes overflow explicitly. Storage-level server-scoped querying is separate follow-up work.</p>
    </section>
}
else if (!Model.IncidentPolicyEvidenceComplete)
{
    <section class="glass-panel state-warning" aria-label="Fleet incident operator policy evidence unavailable">
        <div class="panel-heading"><div><span class="eyebrow">OPERATOR POLICY EVIDENCE</span><h3>Fleet decision support not evaluated</h3></div><span class="status-chip">FAIL CLOSED</span></div>
        <p>Operator metadata required for one or more active incidents is unavailable. Correlation clusters, routing recommendations, and rule hot-spots are withheld rather than inferring environment, suppression, maintenance, or assignment.</p>
        <p class="snapshot-note">An unassigned incident remains valid evidence when metadata is readable; an unavailable metadata read is a different state and is never converted into an unassigned default.</p>
    </section>
}
else if (Model.DecisionSupport is { } decisionSupport)
{
    <partial name="_FleetDecisionSupport" model="decisionSupport" />
}

<section class="glass-panel table-panel"><div class="panel-heading"><div><span class="eyebrow">RULE HOT-SPOTS</span><h3>Open incident concentration</h3></div><span class="snapshot-note">Top 20 deterministic rules</span></div><div class="responsive-table" role="region" aria-label="Rule hot spots" tabindex="0"><div class="table-head fleet-hotspot-grid" role="row"><span>Rule</span><span>Open</span><span>Critical</span><span>Suppressed</span><span>Incidents</span></div>@foreach (var hotspot in Model.RuleHotspots) { <div class="table-row fleet-hotspot-grid" role="row"><strong>@hotspot.RuleId</strong><span>@hotspot.Open</span><span>@hotspot.Critical</span><span>@hotspot.Suppressed</span><a class="secondary-button compact-button" asp-controller="Operations" asp-action="Alerts" asp-route-ruleId="@hotspot.RuleId">Review</a></div> }@if (Model.RuleHotspots.Count == 0) { <div class="incident-empty">@(!Model.IncidentEvidenceComplete ? "Rule hot-spots are unavailable because active incident evidence exceeded the bounded decision-read limit." : !Model.IncidentPolicyEvidenceComplete ? "Rule hot-spots are unavailable because required operator policy metadata could not be read." : "No open incident hot-spots.")</div> }</div></section>
