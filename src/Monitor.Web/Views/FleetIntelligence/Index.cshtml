@using Monitor.Web.Services
@model FleetIntelligenceSnapshot
@{ ViewData["Title"] = "Fleet Intelligence"; }

<section class="page-heading"><div><span class="eyebrow">CACHE-ONLY FLEET</span><h1>Fleet Intelligence</h1><p>Estate rollups are calculated from registrations, operator policy, incidents and snapshot-cache Peek only. This page never initiates monitored SQL collection.</p></div><a class="button secondary" asp-controller="EnterpriseOperations" asp-action="Overview">Enterprise Operations</a></section>

<section class="incident-summary">
    <div class="glass-panel"><small>FRESH</small><strong>@Model.Fresh</strong><span>Cached snapshots</span></div>
    <div class="glass-panel"><small>STALE</small><strong>@Model.Stale</strong><span>Outside fresh window</span></div>
    <div class="glass-panel"><small>UNAVAILABLE</small><strong>@Model.Unavailable</strong><span>No cached snapshot</span></div>
    <div class="glass-panel"><small>MAINTENANCE</small><strong>@Model.Maintenance</strong><span>Scheduled collection paused</span></div>
    <div class="glass-panel"><small>SUPPRESSED</small><strong>@Model.Suppressed</strong><span>Alert actionability only</span></div>
</section>

<section class="dashboard-grid">
    <article class="glass-panel"><div class="panel-heading"><div><span class="eyebrow">ENVIRONMENT</span><h3>Health by environment</h3></div></div>@foreach (var bucket in Model.ByEnvironment) { <p><strong>@bucket.Key</strong> · @bucket.Servers servers · @bucket.Fresh fresh · @bucket.Stale stale · @bucket.Unavailable unavailable · @bucket.Maintenance maintenance</p> }</article>
    <article class="glass-panel"><div class="panel-heading"><div><span class="eyebrow">GROUP</span><h3>Health by group</h3></div></div>@foreach (var bucket in Model.ByGroup) { <p><strong>@bucket.Key</strong> · @bucket.Servers servers · @bucket.Fresh fresh · @bucket.Suppressed suppressed</p> }</article>
    <article class="glass-panel"><div class="panel-heading"><div><span class="eyebrow">TAG</span><h3>Health by tag</h3></div></div>@foreach (var bucket in Model.ByTag) { <p><strong>@bucket.Key</strong> · @bucket.Servers servers · @bucket.Unavailable unavailable</p> }</article>
    <article class="glass-panel"><div class="panel-heading"><div><span class="eyebrow">RISK</span><h3>Cached risk signals</h3></div></div><div class="definition-grid"><div><small>Backup gaps</small><strong>@Model.Risks.BackupGaps</strong></div><div><small>Memory pressure</small><strong>@Model.Risks.MemoryPressure</strong></div><div><small>Blocking risk</small><strong>@Model.Risks.BlockingRisk</strong></div><div><small>Runnable pressure</small><strong>@Model.Risks.RunnableRisk</strong></div></div></article>
</section>

<section class="glass-panel table-panel"><div class="panel-heading"><div><span class="eyebrow">RULE HOT-SPOTS</span><h3>Open incident concentration</h3></div><span class="snapshot-note">Top 20 deterministic rules</span></div><div class="incident-table"><div class="table-head"><span>Rule</span><span>Open</span><span>Critical</span><span>Suppressed</span><span></span><span></span></div>@foreach (var hotspot in Model.RuleHotspots) { <div class="table-row"><strong>@hotspot.RuleId</strong><span>@hotspot.Open</span><span>@hotspot.Critical</span><span>@hotspot.Suppressed</span><span></span><span></span></div> }@if (Model.RuleHotspots.Count == 0) { <div class="incident-empty">No open incident hot-spots.</div> }</div></section>
