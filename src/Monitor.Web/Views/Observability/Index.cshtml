@using Monitor.Web.Services
@model ObservabilityViewModel
@{
    ViewData["Title"] = "Observability";
    var ready = Model.Readiness.Status == ApplicationReadinessStatus.Ready;
}
<div class="data-banner"><strong>PRODUCTION OBSERVABILITY</strong><span>Bounded aggregate runtime telemetry. No SQL text, credentials, endpoints, usernames, IP addresses or request bodies are retained in this surface.</span></div>
<section class="metric-strip">
    <article class="metric-card"><span>READINESS</span><strong>@Model.Readiness.Status</strong><small>@Model.Readiness.Message</small></article>
    <article class="metric-card"><span>SHARED STATE</span><strong>@Model.Readiness.SharedStateStatus</strong><small>Control-plane dependency only</small></article>
    <article class="metric-card"><span>COLLECTOR</span><strong>@Model.Telemetry.CollectorSucceeded / @Model.Telemetry.CollectorAttempts</strong><small>@Model.Telemetry.CollectorFailed failures</small></article>
    <article class="metric-card"><span>ACTIVE INCIDENTS</span><strong>@Model.Telemetry.ActiveIncidents</strong><small>@Model.Telemetry.IncidentObservations observations</small></article>
</section>
<section class="settings-grid">
    <article class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">COLLECTOR</span><h3>Collection runtime</h3></div></div><label>Attempts<div class="fake-input">@Model.Telemetry.CollectorAttempts <span>@Model.Telemetry.CollectorSucceeded succeeded</span></div></label><label>Failures<div class="fake-input">@Model.Telemetry.CollectorFailed <span>@(Model.Telemetry.LastCollectorFailureCategory ?? "None")</span></div></label><label>Last success<div class="fake-input">@(Model.Telemetry.LastCollectorSuccessUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "None") <span>UTC evidence retained</span></div></label><p>Only allowlisted failure categories and timestamps are retained. Raw provider exceptions are excluded.</p></article>
    <article class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">SNAPSHOT CACHE</span><h3>Read/refresh behavior</h3></div></div><label>Fresh reads<div class="fake-input">@Model.Telemetry.CacheFreshReads <span>Cache result</span></div></label><label>Stale reads<div class="fake-input">@Model.Telemetry.CacheStaleReads <span>Explicitly stale</span></div></label><label>Collection misses<div class="fake-input">@Model.Telemetry.CacheMisses <span>Backend collection needed</span></div></label><label>Refresh / coalesced waits<div class="fake-input">@Model.Telemetry.CacheRefreshes / @Model.Telemetry.CacheCoalescedWaits <span>Single-flight</span></div></label></article>
    <article class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">SCHEDULER</span><h3>Cycle telemetry</h3></div></div><label>Cycles<div class="fake-input">@Model.Telemetry.SchedulerCycles <span>@Model.Telemetry.SchedulerSucceeded succeeded</span></div></label><label>Failed cycles<div class="fake-input">@Model.Telemetry.SchedulerFailed <span>Aggregate only</span></div></label><p>Scheduler leadership/collection remains backend-controlled; this page does not start a cycle.</p></article>
    <article class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">INCIDENTS</span><h3>Lifecycle telemetry</h3></div></div><label>Observations<div class="fake-input">@Model.Telemetry.IncidentObservations <span>@Model.Telemetry.ActiveIncidents active</span></div></label><label>Transitions<div class="fake-input">@Model.Telemetry.IncidentTransitionsApplied applied <span>@Model.Telemetry.IncidentTransitionsRejected rejected</span></div></label><p>Incident evidence text is not copied into telemetry.</p></article>
    <article class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">SECURITY</span><h3>Authentication outcomes</h3></div></div><label>Successful logins<div class="fake-input">@Model.Telemetry.LoginSucceeded <span>Aggregate</span></div></label><label>Rejected logins<div class="fake-input">@Model.Telemetry.LoginRejected <span>No username/IP stored</span></div></label><label>Rate-limited<div class="fake-input">@Model.Telemetry.LoginLimited <span>Aggregate</span></div></label><p>Passwords, usernames, addresses, user agents and request bodies are outside the telemetry contract.</p></article>
    <article class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">HEALTH ENDPOINTS</span><h3>Probe contract</h3></div></div><label>Liveness<div class="fake-input">/health/live <span>No dependencies</span></div></label><label>Readiness<div class="fake-input">/health/ready <span>Control-plane only</span></div></label><label>Application health<div class="fake-input">/health <span>Safe aggregates</span></div></label><p>Health probes never query monitored SQL targets and never trigger snapshot collection.</p></article>
</section>
