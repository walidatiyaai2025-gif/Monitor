@using Monitor.Web.Services
@model ObservabilityViewModel
@{
    ViewData["Title"] = "Observability";
    var ready = Model.Readiness.Status == ApplicationReadinessStatus.Ready;
}

<partial name="_PortalPageHeader" model="@(new PortalPageHeaderViewModel("Observability", "Bounded aggregate application telemetry with explicit source and readiness context. SQL text, credentials, endpoints, usernames, IP addresses and request bodies are outside this surface.", "PRODUCTION OBSERVABILITY", "Readiness", Url.Action("Readiness", "EnterpriseHelp")))" />

<section class="observability-context glass-panel" aria-label="Observability source context">
    <div><span class="eyebrow">SOURCE</span><strong>Monitor application telemetry</strong><small>In-process bounded counters + control-plane readiness</small></div>
    <div><span class="eyebrow">CHECKED UTC</span><strong>@Model.Readiness.CheckedAtUtc.ToString("u")</strong><small>Readiness evaluation timestamp</small></div>
    <div><span class="eyebrow">MONITORED SQL</span><strong>NOT QUERIED</strong><small>Opening this page starts no snapshot collection</small></div>
</section>

@if (!ready)
{
    <partial name="_PortalState" model="@(new PortalStateViewModel("Application readiness is degraded", Model.Readiness.Message, "critical", "Open Settings", Url.Action("Settings", "Operations")))" />
}

<section class="health-command-summary" aria-label="Application observability summary">
    <article class="health-command-card hero state-@(ready ? "healthy" : "critical")"><div><small>READINESS</small><strong>@Model.Readiness.Status</strong><span>@Model.Readiness.Message</span></div></article>
    <article class="health-command-card state-@(Model.Readiness.SharedStateStatus == SharedStateReadinessStatus.Ready ? "healthy" : "warning")"><small>SHARED STATE</small><strong>@Model.Readiness.SharedStateStatus</strong><span>Control-plane dependency only</span></article>
    <article class="health-command-card state-@(Model.Telemetry.CollectorFailed > 0 ? "warning" : "healthy")"><small>COLLECTOR SUCCESS</small><strong>@Model.Telemetry.CollectorSucceeded / @Model.Telemetry.CollectorAttempts</strong><span>@Model.Telemetry.CollectorFailed failure(s)</span></article>
    <article class="health-command-card state-@(Model.Telemetry.ActiveIncidents > 0 ? "warning" : "healthy")"><small>ACTIVE INCIDENTS</small><strong>@Model.Telemetry.ActiveIncidents</strong><span>@Model.Telemetry.IncidentObservations observations</span></article>
</section>

<section class="settings-section" aria-labelledby="runtime-observability-title">
    <div class="section-heading"><div><span class="eyebrow">RUNTIME</span><h2 id="runtime-observability-title">Collection & cache behavior</h2></div><span class="snapshot-note">Aggregate counters</span></div>
    <div class="settings-grid">
        <article class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">COLLECTOR</span><h3>Collection runtime</h3></div></div><label>Attempts<div class="fake-input">@Model.Telemetry.CollectorAttempts <span>@Model.Telemetry.CollectorSucceeded succeeded</span></div></label><label>Failures<div class="fake-input">@Model.Telemetry.CollectorFailed <span>@(Model.Telemetry.LastCollectorFailureCategory ?? "None")</span></div></label><label>Last success UTC<div class="fake-input">@(Model.Telemetry.LastCollectorSuccessUtc?.ToString("u") ?? "Not collected") <span>UTC evidence retained</span></div></label><p>Only allowlisted failure categories and timestamps are retained. Raw provider exceptions are excluded.</p></article>
        <article class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">SNAPSHOT CACHE</span><h3>Read / refresh behavior</h3></div></div><label>Fresh reads<div class="fake-input">@Model.Telemetry.CacheFreshReads <span>Cache result</span></div></label><label>Stale reads<div class="fake-input">@Model.Telemetry.CacheStaleReads <span>Explicitly stale</span></div></label><label>Collection misses<div class="fake-input">@Model.Telemetry.CacheMisses <span>Backend collection needed</span></div></label><label>Refresh / coalesced waits<div class="fake-input">@Model.Telemetry.CacheRefreshes / @Model.Telemetry.CacheCoalescedWaits <span>Single-flight</span></div></label></article>
        <article class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">SCHEDULER</span><h3>Cycle telemetry</h3></div></div><label>Cycles<div class="fake-input">@Model.Telemetry.SchedulerCycles <span>@Model.Telemetry.SchedulerSucceeded succeeded</span></div></label><label>Failed cycles<div class="fake-input">@Model.Telemetry.SchedulerFailed <span>Aggregate only</span></div></label><p>Scheduler leadership and collection remain backend-controlled; this page does not start a cycle.</p></article>
    </div>
</section>

<section class="settings-section" aria-labelledby="control-observability-title">
    <div class="section-heading"><div><span class="eyebrow">CONTROL PLANE</span><h2 id="control-observability-title">Incidents, authentication & probes</h2></div><span class="snapshot-note">No sensitive payloads</span></div>
    <div class="settings-grid">
        <article class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">INCIDENTS</span><h3>Lifecycle telemetry</h3></div></div><label>Observations<div class="fake-input">@Model.Telemetry.IncidentObservations <span>@Model.Telemetry.ActiveIncidents active</span></div></label><label>Transitions<div class="fake-input">@Model.Telemetry.IncidentTransitionsApplied applied <span>@Model.Telemetry.IncidentTransitionsRejected rejected</span></div></label><p>Incident evidence text is not copied into telemetry.</p></article>
        <article class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">SECURITY</span><h3>Authentication outcomes</h3></div></div><label>Successful logins<div class="fake-input">@Model.Telemetry.LoginSucceeded <span>Aggregate</span></div></label><label>Rejected logins<div class="fake-input">@Model.Telemetry.LoginRejected <span>No username/IP stored</span></div></label><label>Rate-limited<div class="fake-input">@Model.Telemetry.LoginLimited <span>Aggregate</span></div></label><p>Passwords, usernames, addresses, user agents and request bodies are outside the telemetry contract.</p></article>
        <article class="glass-panel settings-card"><div class="panel-heading"><div><span class="eyebrow">HEALTH ENDPOINTS</span><h3>Probe contract</h3></div></div><label>Liveness<div class="fake-input">/health/live <span>No dependencies</span></div></label><label>Readiness<div class="fake-input">/health/ready <span>Control-plane only</span></div></label><label>Application health<div class="fake-input">/health <span>Safe aggregates</span></div></label><p>Health probes never query monitored SQL targets and never trigger snapshot collection.</p></article>
    </div>
</section>
