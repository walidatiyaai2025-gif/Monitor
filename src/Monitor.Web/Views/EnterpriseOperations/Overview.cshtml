@using Monitor.Web.Controllers
@using Monitor.Web.Services
@model EnterpriseOperationsViewModel
@{
    ViewData["Title"] = "Enterprise Operations";
    var canOperate = User.IsInRole(MonitorRoles.Operator) || User.IsInRole(MonitorRoles.Administrator);
    var canManage = User.IsInRole(MonitorRoles.Administrator);
}

<section class="page-shell" aria-labelledby="enterprise-heading">
    <div class="page-heading">
        <div>
            <p class="eyebrow">CONTROL PLANE</p>
            <h1 id="enterprise-heading">Enterprise Operations</h1>
            <p>Maintenance, classification, suppression, incident ownership, exports and redacted diagnostics. This surface reads Monitor-owned metadata and cached evidence only.</p>
        </div>
        <div class="hero-actions">
            <a class="button secondary" href="/reports/servers.csv">Export safe CSV</a>
            @if (canManage)
            {
                <a class="button secondary" href="/diagnostics/package">Download diagnostics</a>
            }
        </div>
    </div>

    @if (TempData["OperatorStatus"] is string status)
    {
        <div class="status-banner" role="status" aria-live="polite">@status</div>
    }

    <section class="panel" aria-labelledby="server-ops-heading">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">ESTATE GOVERNANCE</p>
                <h2 id="server-ops-heading">Server metadata</h2>
            </div>
            <span class="metric-value">@Model.Servers.Count</span>
        </div>

        @if (Model.Servers.Count == 0)
        {
            <p class="empty-state">No registered servers.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Server</th>
                        <th>Environment</th>
                        <th>Group / tags</th>
                        <th>Maintenance</th>
                        <th>Alert suppression</th>
                        @if (canManage) { <th>Update</th> }
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Servers)
                    {
                        var maintenance = row.Metadata.MaintenanceWindow;
                        var suppression = row.Metadata.AlertSuppressionWindow;
                        <tr>
                            <td>
                                <strong>@row.Registration.DisplayName</strong>
                                <div class="meta-line">@row.Registration.Id.ToString("D")</div>
                            </td>
                            <td><span class="status-chip">@row.Metadata.Environment</span></td>
                            <td>
                                <div>@(row.Metadata.Group ?? "—")</div>
                                <div class="meta-line">@(row.Metadata.Tags.Length == 0 ? "No tags" : string.Join(", ", row.Metadata.Tags))</div>
                            </td>
                            <td>
                                @if (maintenance is null)
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    <div>@maintenance.StartsAtUtc.ToString("u") → @maintenance.EndsAtUtc.ToString("u")</div>
                                    <div class="meta-line">@maintenance.Reason</div>
                                }
                            </td>
                            <td>
                                @if (suppression is null)
                                {
                                    <span>—</span>
                                }
                                else
                                {
                                    <div>@suppression.StartsAtUtc.ToString("u") → @suppression.EndsAtUtc.ToString("u")</div>
                                    <div class="meta-line">@suppression.Reason</div>
                                }
                            </td>
                            @if (canManage)
                            {
                                <td>
                                    <details>
                                        <summary class="button secondary">Edit</summary>
                                        <form class="stack-form" method="post" action="/servers/@row.Registration.Id/operator-profile">
                                            @Html.AntiForgeryToken()
                                            <label>Environment
                                                <select name="environment">
                                                    @foreach (var environment in Enum.GetValues<ServerEnvironmentClass>())
                                                    {
                                                        if (environment == row.Metadata.Environment)
                                                        {
                                                            <option value="@environment" selected>@environment</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@environment">@environment</option>
                                                        }
                                                    }
                                                </select>
                                            </label>
                                            <label>Group <input name="group" maxlength="60" value="@row.Metadata.Group" /></label>
                                            <label>Tags <input name="tags" maxlength="329" value="@string.Join(',', row.Metadata.Tags)" placeholder="prod,finance,tier-1" /></label>
                                            <label>Maintenance start UTC <input name="maintenanceStartUtc" type="datetime-local" value="@(maintenance?.StartsAtUtc.UtcDateTime.ToString("yyyy-MM-ddTHH:mm"))" /></label>
                                            <label>Maintenance end UTC <input name="maintenanceEndUtc" type="datetime-local" value="@(maintenance?.EndsAtUtc.UtcDateTime.ToString("yyyy-MM-ddTHH:mm"))" /></label>
                                            <label>Maintenance reason <input name="maintenanceReason" maxlength="200" value="@maintenance?.Reason" /></label>
                                            <label>Suppression start UTC <input name="suppressionStartUtc" type="datetime-local" value="@(suppression?.StartsAtUtc.UtcDateTime.ToString("yyyy-MM-ddTHH:mm"))" /></label>
                                            <label>Suppression end UTC <input name="suppressionEndUtc" type="datetime-local" value="@(suppression?.EndsAtUtc.UtcDateTime.ToString("yyyy-MM-ddTHH:mm"))" /></label>
                                            <label>Suppression reason <input name="suppressionReason" maxlength="200" value="@suppression?.Reason" /></label>
                                            <button class="button primary" type="submit">Save metadata</button>
                                        </form>
                                    </details>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel" aria-labelledby="incident-ops-heading">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">INCIDENT GOVERNANCE</p>
                <h2 id="incident-ops-heading">Ownership, notes & recommendations</h2>
            </div>
            <span class="metric-value">@Model.Incidents.Count</span>
        </div>

        @if (Model.Incidents.Count == 0)
        {
            <p class="empty-state">No incidents.</p>
        }
        else
        {
            <div class="card-grid">
                @foreach (var row in Model.Incidents)
                {
                    <article class="panel compact-panel">
                        <div class="panel-heading">
                            <div>
                                <span class="status-chip">@row.Incident.Status</span>
                                <h3>@row.Incident.Title</h3>
                                <p class="meta-line">@row.Incident.RuleId · @row.Incident.LastObservedAtUtc.ToString("u")</p>
                            </div>
                        </div>

                        <dl class="definition-grid">
                            <div><dt>Assignee</dt><dd>@(row.Metadata.Assignee ?? "Unassigned")</dd></div>
                            <div><dt>Notes</dt><dd>@row.Metadata.Notes.Length / @EnterpriseOperatorValidation.MaxNotesPerIncident</dd></div>
                        </dl>

                        @if (canOperate)
                        {
                            <form class="inline-form" method="post" action="/alerts/@Uri.EscapeDataString(row.Incident.Id)/owner">
                                @Html.AntiForgeryToken()
                                <label class="sr-only" for="owner-@row.Incident.Id.GetHashCode()">Incident owner</label>
                                <input id="owner-@row.Incident.Id.GetHashCode()" name="assignee" maxlength="80" value="@row.Metadata.Assignee" placeholder="Owner / team" />
                                <button class="button secondary" type="submit">Assign</button>
                            </form>

                            <form class="stack-form" method="post" action="/alerts/@Uri.EscapeDataString(row.Incident.Id)/notes">
                                @Html.AntiForgeryToken()
                                <label>Operator note
                                    <textarea name="note" maxlength="500" rows="3" required></textarea>
                                </label>
                                <button class="button secondary" type="submit">Add note</button>
                            </form>
                        }

                        @if (row.Metadata.Notes.Length > 0)
                        {
                            <ul class="activity-list">
                                @foreach (var note in row.Metadata.Notes.OrderByDescending(item => item.OccurredAtUtc).Take(5))
                                {
                                    <li><strong>@note.Actor</strong> · @note.OccurredAtUtc.ToString("u")<br />@note.Text</li>
                                }
                            </ul>
                        }

                        @if (row.Recommendation is not null && row.RecommendationKey is not null)
                        {
                            <div class="recommendation-card">
                                <div class="panel-heading">
                                    <div>
                                        <p class="eyebrow">RECOMMENDATION</p>
                                        <h4>@row.Recommendation.RuleId</h4>
                                    </div>
                                    <span class="status-chip">@(row.RecommendationAcknowledged ? "Acknowledged" : "Review")</span>
                                </div>
                                <p>@row.Recommendation.Explanation</p>
                                @if (canOperate)
                                {
                                    <form method="post" action="/alerts/@Uri.EscapeDataString(row.Incident.Id)/recommendation/@row.RecommendationKey/acknowledge">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="acknowledged" value="@(row.RecommendationAcknowledged ? "false" : "true")" />
                                        <button class="button secondary" type="submit">@(row.RecommendationAcknowledged ? "Reopen review" : "Acknowledge recommendation")</button>
                                    </form>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>
</section>
