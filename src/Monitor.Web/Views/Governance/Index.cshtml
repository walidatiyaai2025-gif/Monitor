@using Monitor.Web.Services
@model GovernanceCleanupPlan
@{ ViewData["Title"] = "Retention Governance"; }
<section class="page-heading"><div><span class="eyebrow">ADMINISTRATOR GOVERNANCE</span><h1>Retention Governance</h1><p>Dry-run candidates are computed from Monitor-owned metadata and audit state. Apply writes reversible audit-backed prune receipts; it never initiates monitored SQL collection.</p></div></section>
@if (TempData["GovernanceStatus"] is string status) { <div class="status-banner" role="status">@status</div> }
<section class="incident-summary"><div class="glass-panel"><small>ORPHAN SERVERS</small><strong>@Model.OrphanServers</strong></div><div class="glass-panel"><small>INCIDENT METADATA</small><strong>@Model.IncidentMetadata</strong></div><div class="glass-panel"><small>EXPIRED NOTES</small><strong>@Model.ExpiredNotes</strong></div><div class="glass-panel"><small>TOTAL</small><strong>@Model.Candidates.Count</strong></div></section>
<section class="glass-panel table-panel"><div class="panel-heading"><div><span class="eyebrow">DRY RUN</span><h3>Cleanup candidates</h3></div><span class="snapshot-note">@Model.EvaluatedAtUtc.ToString("u")</span></div><div class="incident-table"><div class="table-head"><span>Kind</span><span>Key</span><span>Reason</span><span></span><span></span><span></span></div>@foreach (var item in Model.Candidates.Take(100)) { <div class="table-row"><strong>@item.Kind</strong><span>@item.Key</span><span>@item.Reason</span><span></span><span></span><span></span></div> }@if (Model.Candidates.Count == 0) { <div class="incident-empty">No cleanup candidates.</div> }</div></section>
@if (Model.Candidates.Count > 0) { <form asp-action="Apply" method="post"><button class="button primary" type="submit">Apply audited pruning</button></form> }
