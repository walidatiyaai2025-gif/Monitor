@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? string.Empty;
    string Active(string value, bool exact = false)
    {
        var match = exact
            ? path == value
            : path == value || path.StartsWith($"{value}/", StringComparison.Ordinal);
        return match ? "nav-link active" : "nav-link";
    }
    var serverNavClass = path == "/servers" || (path.StartsWith("/servers/", StringComparison.Ordinal) && !path.StartsWith("/servers/connections", StringComparison.Ordinal)) ? "nav-link active" : "nav-link";
    var bodyClass = path.StartsWith("/dashboard", StringComparison.Ordinal) ? "app-body wallboard-ready" : "app-body";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07111f" />
    <title>@ViewData["Title"] · Monitor</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/command-center.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui003.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui004.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/connection-lab.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dba-operations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
</head>
<body class="@bodyClass">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="ambient-grid" aria-hidden="true"></div>
    <aside class="sidebar" data-sidebar>
        <a class="brand" asp-controller="Operations" asp-action="Dashboard" aria-label="Monitor SQL Operations home">
            <span class="brand-mark" aria-hidden="true"><span></span></span>
            <span><strong>MONITOR</strong><small>SQL OPERATIONS</small></span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-nav-toggle>
            <span aria-hidden="true">☰</span><span class="sr-only">Toggle navigation</span>
        </button>

        <nav class="primary-nav" id="primary-navigation" aria-label="Primary navigation">
            <span class="nav-section">OPERATIONS</span>
            <a class="@Active("/dashboard")" asp-controller="Operations" asp-action="Dashboard"><span class="nav-icon" aria-hidden="true">⌁</span>Command Center</a>
            <a class="@serverNavClass" asp-controller="Operations" asp-action="Servers"><span class="nav-icon" aria-hidden="true">▦</span>Servers</a>
            <a class="@Active("/alerts")" asp-controller="Operations" asp-action="Alerts"><span class="nav-icon" aria-hidden="true">△</span>Alerts & Incidents</a>

            <span class="nav-section">HEALTH</span>
            <a class="@Active("/database-health")" asp-controller="Operations" asp-action="DatabaseHealth"><span class="nav-icon" aria-hidden="true">◫</span>Database Health</a>
            <a class="@Active("/memory-health")" asp-controller="Operations" asp-action="MemoryHealth"><span class="nav-icon" aria-hidden="true">◒</span>Memory Health</a>
            <a class="@Active("/performance-health")" asp-controller="Portal" asp-action="Performance"><span class="nav-icon" aria-hidden="true">⌁</span>Performance</a>
            <a class="@Active("/backups")" asp-controller="Operations" asp-action="Backups"><span class="nav-icon" aria-hidden="true">▣</span>Backups</a>
            <a class="@Active("/jobs")" asp-controller="Operations" asp-action="Jobs"><span class="nav-icon" aria-hidden="true">◆</span>SQL Agent</a>
            <a class="@Active("/storage")" asp-controller="Operations" asp-action="Storage"><span class="nav-icon" aria-hidden="true">◧</span>Storage</a>
            <a class="@Active("/blocking")" asp-controller="Operations" asp-action="Blocking"><span class="nav-icon" aria-hidden="true">⇄</span>Blocking</a>

            <span class="nav-section">INTELLIGENCE</span>
            <a class="@Active("/enterprise/fleet")" asp-controller="FleetIntelligence" asp-action="Index"><span class="nav-icon" aria-hidden="true">◎</span>Fleet Intelligence</a>
            <a class="@Active("/enterprise", exact: true)" asp-controller="EnterpriseOperations" asp-action="Overview"><span class="nav-icon" aria-hidden="true">◇</span>Enterprise Operations</a>
            <a class="@Active("/recommendations")" asp-controller="Portal" asp-action="Recommendations"><span class="nav-icon" aria-hidden="true">⌘</span>Recommendations</a>
            <a class="@Active("/reports", exact: true)" asp-controller="Portal" asp-action="Reports"><span class="nav-icon" aria-hidden="true">▤</span>Reports</a>

            @if (User.IsInRole(Monitor.Web.Services.MonitorRoles.Administrator))
            {
                <span class="nav-section">ADMINISTRATION</span>
                <a class="@Active("/servers/connections")" asp-controller="ConnectionLab" asp-action="Index"><span class="nav-icon" aria-hidden="true">＋</span>Connections</a>
                <a class="@Active("/observability")" asp-controller="Observability" asp-action="Index"><span class="nav-icon" aria-hidden="true">◎</span>Observability</a>
                <a class="@Active("/audit")" asp-controller="Operations" asp-action="Audit"><span class="nav-icon" aria-hidden="true">≡</span>Audit Trail</a>
                <a class="@Active("/enterprise/readiness")" asp-controller="EnterpriseHelp" asp-action="Readiness"><span class="nav-icon" aria-hidden="true">✓</span>Readiness</a>
                <a class="@Active("/settings")" asp-controller="Operations" asp-action="Settings"><span class="nav-icon" aria-hidden="true">⚙</span>Settings</a>
            }
        </nav>

        <div class="sidebar-footer">
            <div class="environment-badge"><span aria-hidden="true"></span> SQL SNAPSHOT MODE</div>
            <a class="@Active("/enterprise/help")" asp-controller="EnterpriseHelp" asp-action="Help"><span class="nav-icon" aria-hidden="true">?</span>Operator Help</a>
        </div>
    </aside>

    <main class="main-shell" id="main-content" tabindex="-1">
        <header class="topbar">
            <div>
                <span class="eyebrow">DATABASE OPERATIONS CENTER</span>
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="topbar-actions">
                <div class="collector-state" role="status" aria-live="polite"><span class="live-dot" aria-hidden="true"></span><div><strong>Collector</strong><small data-scan-phase>Snapshot cache active</small></div></div>
                <div class="user-chip"><span aria-hidden="true">AD</span><div><strong>@User.Identity?.Name</strong><small>@(User.IsInRole("Administrator") ? "Administrator" : User.IsInRole("Operator") ? "Operator" : "Viewer")</small></div></div>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="icon-button" aria-label="Sign out" title="Sign out" type="submit">↗</button></form>
            </div>
        </header>
        <section class="page-content">
            @RenderBody()
        </section>
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ui003.js" asp-append-version="true"></script>
    <script src="~/js/ui004.js" asp-append-version="true"></script>
    <script src="~/js/connection-lab.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
