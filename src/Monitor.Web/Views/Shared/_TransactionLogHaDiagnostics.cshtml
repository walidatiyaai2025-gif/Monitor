@using Monitor.Web.Services
@model HealthModulePageViewModel

<section class="dashboard-grid" style="margin-top:14px" aria-label="Transaction log diagnostics">
    @foreach (var server in Model.Servers)
    {
        var rows = AdvancedEvidenceProjection.BuildTransactionLogs(server.TransactionLogs);
        var displayed = rows.Take(12).ToArray();
        var blocked = rows.Count(item => item.TruncationBlocked == true);
        var highVlf = rows.Count(item => item.VlfBand is LogVlfBand.High or LogVlfBand.Extreme);
        <article class="glass-panel ops-panel state-@(blocked > 0 || highVlf > 0 ? "warning" : "unknown")">
            <div class="panel-heading"><div><span class="eyebrow">@server.Name · TRANSACTION LOG</span><h3>Bounded log evidence</h3></div><partial name="_HealthSourceBadge" model="server" /></div>
            @if (server.TransactionLogs is null)
            {
                <p class="panel-copy"><strong>Not collected.</strong> Transaction-log evidence is unavailable. No zero, healthy state or backup-policy compliance is inferred.</p>
            }
            else if (rows.Count == 0)
            {
                <p class="panel-copy">No eligible online user-database log rows were retained in this snapshot.</p>
            }
            else
            {
                <div class="responsive-table" role="table" aria-label="@server.Name transaction log evidence" tabindex="0">
                    <div class="table-head health-detail-grid" role="row"><span role="columnheader">Database</span><span role="columnheader">Recovery</span><span role="columnheader">Used</span><span role="columnheader">VLF</span><span role="columnheader">Reuse wait</span><span role="columnheader">Log backup age</span><span role="columnheader">Detail</span></div>
                    @foreach (var row in displayed)
                    {
                        var warning = row.TruncationBlocked == true || row.VlfBand is LogVlfBand.High or LogVlfBand.Extreme;
                        <div class="table-row health-detail-grid" role="row">
                            <strong role="cell">@row.DatabaseKey</strong>
                            <span role="cell">@row.RecoveryModel</span>
                            <span role="cell">@(row.UsedPercent.HasValue ? $"{row.UsedPercent.Value:0.##}%" : "Unavailable")</span>
                            <span role="cell" class="@(warning ? "state-warning" : string.Empty)">@(row.VlfBand?.ToString() ?? "Unavailable")</span>
                            <span role="cell">@(row.ReuseWait ?? "Unavailable")</span>
                            <span role="cell">@(row.LogBackupAgeSeconds.HasValue ? TimeSpan.FromSeconds(row.LogBackupAgeSeconds.Value).ToString("c") : "Unavailable")</span>
                            <span role="cell">@(row.HasDetailedStats ? (row.TruncationBlocked == true ? "Reuse blocked" : "Observed") : "Partial evidence")</span>
                        </div>
                    }
                </div>
                <p class="server-mini-note">Showing @displayed.Length of @rows.Count retained row(s). Reuse-blocked: @blocked · high/extreme VLF: @highVlf. Oldest-active-transaction age, growth/hour and policy-backed backup compliance are not evaluated here.</p>
            }
            <div style="margin-top:12px"><a class="secondary-button" asp-controller="Operations" asp-action="ServerDetails" asp-route-id="@server.Id">Open full server evidence</a></div>
        </article>
    }
</section>

<section class="dashboard-grid" style="margin-top:14px" aria-label="HA diagnostics">
    @foreach (var server in Model.Servers)
    {
        var diagnostics = AdvancedEvidenceProjection.BuildHa(server.Ha);
        var databaseRows = server.Ha?.DatabaseReplicas?.Take(12).ToArray() ?? [];
        var warning = diagnostics is not null && diagnostics.IsHadrEnabled &&
            (diagnostics.DisconnectedReplicas > 0 || diagnostics.UnhealthyReplicas > 0 || diagnostics.UnsynchronizedDatabases > 0 || diagnostics.SuspendedDatabases > 0);
        <article class="glass-panel ops-panel state-@(warning ? "warning" : "unknown")">
            <div class="panel-heading"><div><span class="eyebrow">@server.Name · HA</span><h3>Availability-group evidence</h3></div><partial name="_HealthSourceBadge" model="server" /></div>
            @if (diagnostics is null)
            {
                <p class="panel-copy"><strong>Not collected.</strong> HA evidence is unavailable. No readiness state is inferred.</p>
            }
            else if (!diagnostics.IsHadrEnabled)
            {
                <p class="panel-copy">SQL Server reports HADR disabled. Quorum, RPO, RTO and failover readiness are therefore not evaluated by this surface.</p>
            }
            else
            {
                <div class="health-command-summary" aria-label="@server.Name HA evidence summary">
                    <div class="health-command-card"><small>REPLICAS</small><strong>@diagnostics.TotalReplicas</strong><span>@(diagnostics.ReplicasTruncated ? "retained evidence truncated" : "metadata observed")</span></div>
                    <div class="health-command-card state-@(diagnostics.DisconnectedReplicas > 0 ? "warning" : "unknown")"><small>DISCONNECTED</small><strong>@diagnostics.DisconnectedReplicas</strong><span>Observed replica state</span></div>
                    <div class="health-command-card state-@(diagnostics.SuspendedDatabases > 0 ? "warning" : "unknown")"><small>SUSPENDED DBS</small><strong>@diagnostics.SuspendedDatabases</strong><span>Observed data movement</span></div>
                    <div class="health-command-card"><small>MAX LAG</small><strong>@(diagnostics.MaxSecondaryLagSeconds.HasValue ? $"{diagnostics.MaxSecondaryLagSeconds.Value}s" : "Unavailable")</strong><span>SQL Server-reported lag</span></div>
                </div>
                @if (databaseRows.Length > 0)
                {
                    <div class="responsive-table" role="table" aria-label="@server.Name HA database replica evidence" tabindex="0">
                        <div class="table-head health-detail-grid" role="row"><span role="columnheader">Database</span><span role="columnheader">Replica</span><span role="columnheader">Sync state</span><span role="columnheader">Health</span><span role="columnheader">Suspended</span><span role="columnheader">Lag</span><span role="columnheader">Queues</span></div>
                        @foreach (var row in databaseRows)
                        {
                            var rowWarning = row.IsSuspended == true || string.Equals(row.SynchronizationHealth, "NOT_HEALTHY", StringComparison.OrdinalIgnoreCase);
                            <div class="table-row health-detail-grid" role="row">
                                <strong role="cell">@row.DatabaseKey</strong>
                                <span role="cell">@row.ReplicaKey</span>
                                <span role="cell">@(row.SynchronizationState ?? "Unavailable")</span>
                                <span role="cell" class="@(rowWarning ? "state-warning" : string.Empty)">@(row.SynchronizationHealth ?? "Unavailable")</span>
                                <span role="cell">@(row.IsSuspended.HasValue ? (row.IsSuspended.Value ? "YES" : "NO") : "Unavailable")</span>
                                <span role="cell">@(row.SecondaryLagSeconds.HasValue ? $"{row.SecondaryLagSeconds.Value}s" : "Unavailable")</span>
                                <span role="cell">send @(row.LogSendQueueKb.HasValue ? $"{row.LogSendQueueKb.Value} KB" : "n/a") · redo @(row.RedoQueueKb.HasValue ? $"{row.RedoQueueKb.Value} KB" : "n/a")</span>
                            </div>
                        }
                    </div>
                }
                <p class="server-mini-note">Showing @databaseRows.Length of @(server.Ha?.DatabaseReplicas?.Count ?? 0) retained database-replica row(s). Direct synchronization/queue/lag evidence is shown; quorum votes, policy-backed RPO/RTO and failover readiness remain not evaluated.</p>
            }
            <div style="margin-top:12px"><a class="secondary-button" asp-controller="Operations" asp-action="ServerDetails" asp-route-id="@server.Id">Open full server evidence</a></div>
        </article>
    }
</section>
